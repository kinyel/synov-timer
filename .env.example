# Build-time settings (read by Astro). Copy to .env for local builds;
# set the same names in Cloudflare Pages › Settings › Environment variables.

# Cloudflare Turnstile site key for the contact form (public).
# Local testing: 1x00000000000000000000AA always passes.
PUBLIC_TURNSTILE_SITE_KEY=

# true = show draft blog posts, case studies and roles (preview builds only).
# A drafts build is marked noindex and its robots.txt disallows everything.
PUBLIC_SHOW_DRAFTS=false
