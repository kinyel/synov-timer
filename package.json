{
  "name": "raleston-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc --noEmit && astro build",
    "preview": "wrangler pages dev dist",
    "check": "astro check && tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist --project-name raleston-web",
    "contrast": "node scripts/contrast.mjs",
    "qa": "node scripts/pages.mjs",
    "fps": "node scripts/pagefps.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "nanostores": "^1.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "satori": "^0.35.1",
    "wrangler": "^4.147.0"
  }
}
