---
const links = [
  { href: '/#expertise', label: 'Expertise' },
  { href: '/#services', label: 'Services' },
  { href: '/#industries', label: 'Industries' },
  { href: '/#impact', label: 'Impact' },
];
---

<!--
  Colours come from html[data-theme], which main.ts sets from whichever
  section is under the nav, so it flips between dark and bright sections.
-->
<header
  class="nav gutter fixed inset-x-0 top-0 z-50 flex items-center justify-between pt-[max(1rem,env(safe-area-inset-top))] pb-4 transition-colors duration-500"
>
  <a href="/" class="flex items-center gap-3" aria-label="Raleston Consulting, home">
    <img src="/brand/mark.svg" alt="" width="40" height="34" class="h-8 w-auto" />
    <span class="nav-ink font-display text-[1.05rem] leading-[1.05] font-semibold tracking-tight">Raleston<br /><span class="font-normal opacity-70">Consulting</span></span>
  </a>
  <nav aria-label="Primary" class="hidden items-center gap-1 md:flex">
    {
      links.map((l) => (
        <a href={l.href} class="nav-ink rounded-full px-4 py-2 text-sm opacity-80 transition-opacity hover:opacity-100">
          {l.label}
        </a>
      ))
    }
    <a href="/#contact" class="btn btn-gold ml-3 !py-3 text-sm" data-magnetic>Contact us</a>
  </nav>
  <button class="nav-ink btn !px-4 !py-3 text-sm shadow-[inset_0_0_0_1.5px_currentColor] md:hidden" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
    Menu
  </button>
  <div
    id="mobile-menu"
    class="gutter pointer-events-none fixed inset-0 z-[-1] flex flex-col justify-end bg-void/95 pb-[max(2rem,env(safe-area-inset-bottom))] opacity-0 backdrop-blur-xl transition-opacity duration-500"
    aria-hidden="true"
    data-menu
  >
    <ul class="flex flex-col gap-1">
      {
        [...links, { href: '/#contact', label: 'Contact us' }].map((l) => (
          <li>
            <a href={l.href} class="display block py-1 text-[12vw] text-snow">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="label mt-8 text-muted">info@ralestonconsulting.com · +1 (613) 981-1843</p>
  </div>
</header>

<style>
  .nav-ink {
    color: var(--color-snow);
    transition: color 0.5s var(--ease-expo);
  }
  :global(html[data-theme='light']) .nav-ink {
    color: var(--color-ink);
  }
  :global(html[data-menu-open]) .nav-ink {
    color: var(--color-snow);
  }
</style>
