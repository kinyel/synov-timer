---
/**
 * Navigation. Three parts: the mark (left), a glass pill of page links with
 * one morphing flyout for Services (centre), and the "Talk to an architect"
 * call to action (right). Colours are theme tokens (see `.nav` below) that
 * cross-fade between light and dark treatments as html[data-theme] follows the
 * section underneath. Behaviour lives in src/scripts/nav.ts.
 */
import { SITE } from '../../data/site';
import { DELIVERY, PLATFORM } from '../../data/services';
import Icon from '../ui/Icon.astro';

const path = Astro.url.pathname;
const isActive = (prefix: string) => path === prefix || path.startsWith(prefix);
const columns = [
  { title: 'Platform', items: PLATFORM },
  { title: 'Delivery', items: DELIVERY },
];
const links = [
  { label: 'Industries', href: '/#industries', active: false },
  { label: 'Case studies', href: '/case-studies/', active: isActive('/case-studies/') },
  { label: 'About', href: '/about/', active: isActive('/about/') },
  { label: 'Blog', href: '/blog/', active: isActive('/blog/') },
];
---

<header class="nav fixed inset-x-0 top-0 z-50" data-nav>
  <a href="#main" class="nav-skip">Skip to content</a>
  <div class="nav-bar gutter grid grid-cols-[1fr_auto_1fr] items-center gap-6">
    <!-- Mark -->
    <a href="/" class="nav-brand col-start-1 flex w-fit shrink-0 items-center gap-3" aria-label="Raleston Consulting, home" data-nav-home>
      <img src="/brand/mark.svg" alt="" width="40" height="34" class="h-8 w-auto" />
      <span class="nav-word font-display text-[1.02rem] leading-[1.05] font-semibold tracking-[-0.01em]">
        Raleston<br /><span class="nav-muted font-normal">Consulting</span>
      </span>
    </a>

    <!-- Page links (desktop) -->
    <nav aria-label="Primary" class="nav-pill relative col-start-2 hidden items-center lg:flex" data-nav-pill>
      <span class="nav-hover" aria-hidden="true" data-nav-hover></span>
      <button type="button" class="nav-link" data-cursor="none" aria-expanded="false" aria-controls="nav-flyout" data-nav-trigger="services" data-active={isActive('/services/') ? '' : undefined}>
        <span>Services</span>
        <svg viewBox="0 0 10 6" class="nav-chev" aria-hidden="true">
          <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="nav-dot" aria-hidden="true"></span>
      </button>
      {
        links.map((l) => (
          <a href={l.href} class="nav-link" data-cursor="none" data-active={l.active ? '' : undefined} aria-current={l.active ? 'page' : undefined}>
            <span>{l.label}</span>
            <span class="nav-dot" aria-hidden="true" />
          </a>
        ))
      }

      <!-- One flyout; it morphs to fit its pane. -->
      <div id="nav-flyout" class="nav-flyout" role="region" aria-label="Services menu" data-nav-flyout>
        <span class="nav-flyout-arrow" aria-hidden="true" data-nav-arrow></span>
        <div class="nav-flyout-clip" data-nav-clip>
          <div class="nav-pane" data-nav-pane="services" hidden>
            <div class="nav-cols">
              {
                columns.map((c) => (
                  <div>
                    <p class="nav-eyebrow">{c.title}</p>
                    <ul class="nav-grid">
                      {c.items.map((s, i) => (
                        <li style={`--i:${i}`}>
                          <a href={`/services/${s.slug}/`} class="nav-item" data-cursor="none">
                            <span class="nav-item-icon">
                              <Icon name={s.icon} />
                            </span>
                            <span>
                              <span class="nav-item-title">{s.short === s.name ? s.name : `${s.short}`}</span>
                              <span class="nav-item-body">{s.blurb}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
            <a href="/services/" class="nav-all" data-cursor="none">
              All services and how we deliver them
              <Icon name="arrow" />
            </a>
          </div>
        </div>
      </div>
    </nav>

    <!-- CTA (tablet and up) + menu button (below desktop) -->
    <div class="col-start-3 flex items-center justify-self-end gap-2">
      <a href="/contact/" class="nav-cta nav-cta-bar" data-cursor="none" aria-current={isActive('/contact/') ? 'page' : undefined}>
        <span class="nav-cta-fill" aria-hidden="true"></span>
        <span class="relative">Talk to an architect</span>
        <span class="nav-cta-chip" aria-hidden="true">
          <svg viewBox="0 0 12 12"><path d="M3 9L9 3M4.5 3H9v4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </span>
      </a>
      <button type="button" class="nav-burger" aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu" data-menu-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <!-- Mobile / tablet sheet -->
  <div id="mobile-menu" class="nav-sheet" aria-hidden="true" data-menu>
    <div class="gutter flex min-h-full flex-col pt-28 pb-[max(1.5rem,env(safe-area-inset-bottom))]">
      <ul class="flex flex-col">
        <li class="nav-sheet-row">
          <button type="button" class="nav-sheet-link" aria-expanded="false" data-sheet-toggle>
            <span>Services</span>
            <span class="nav-sheet-plus" aria-hidden="true"></span>
          </button>
          <div class="nav-sheet-sub" data-sheet-sub>
            <div class="nav-sheet-cols">
              {
                columns.map((c) => (
                  <div>
                    <p class="nav-sheet-eyebrow">{c.title}</p>
                    <ul>
                      {c.items.map((s) => (
                        <li>
                          <a href={`/services/${s.slug}/`}>{s.short === s.name ? s.name : s.short}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </div>
        </li>
        {
          links.map((l) => (
            <li class="nav-sheet-row">
              <a href={l.href} class="nav-sheet-link" aria-current={l.active ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
        <li class="nav-sheet-row">
          <a href="/glossary/" class="nav-sheet-link">Glossary</a>
        </li>
      </ul>
      <div class="mt-auto pt-10">
        <a href="/contact/" class="nav-cta w-full justify-between">
          <span class="nav-cta-fill" aria-hidden="true"></span>
          <span class="relative">Talk to an architect</span>
          <span class="nav-cta-chip" aria-hidden="true">
            <svg viewBox="0 0 12 12"><path d="M3 9L9 3M4.5 3H9v4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </span>
        </a>
        <p class="label nav-muted mt-5 flex flex-wrap gap-x-4 gap-y-1 text-[0.7rem]">
          <span>{SITE.email}</span><span>{SITE.phone}</span>
        </p>
      </div>
    </div>
  </div>
</header>

<style>
  /* ── Theme tokens: registered in global.css (@property) so they animate. ── */
  .nav {
    --n-fg: var(--color-navy);
    --n-muted: rgb(10 29 59 / 0.62);
    --n-glass: rgb(255 255 255 / 0.7);
    --n-solid: rgb(255 255 255 / 0.95);
    --n-border: rgb(10 29 59 / 0.08);
    --n-hover: rgb(10 29 59 / 0.05);
    --n-shadow: rgb(10 29 59 / 0.14);
    --n-accent: var(--color-gold-ink);
    --n-accent-fill: var(--color-gold);
    --n-accent-line: rgb(236 188 4 / 0.55);
    --n-accent-tint: rgb(236 188 4 / 0.14);
    --n-accent-glow: rgb(236 188 4 / 0.24);
    color: var(--n-fg);
    transition:
      --n-fg 0.7s var(--ease-expo),
      --n-muted 0.7s var(--ease-expo),
      --n-glass 0.7s var(--ease-expo),
      --n-solid 0.7s var(--ease-expo),
      --n-border 0.7s var(--ease-expo),
      --n-hover 0.7s var(--ease-expo),
      --n-shadow 0.7s var(--ease-expo),
      --n-accent 0.7s var(--ease-expo),
      --n-accent-line 0.7s var(--ease-expo),
      --n-accent-tint 0.7s var(--ease-expo),
      --n-accent-glow 0.7s var(--ease-expo),
      transform 0.6s var(--ease-expo);
  }
  :global(html[data-theme='dark']) .nav {
    --n-fg: var(--color-white);
    --n-muted: rgb(255 255 255 / 0.64);
    --n-glass: rgb(10 29 59 / 0.55);
    --n-solid: rgb(10 29 59 / 0.97);
    --n-border: rgb(255 255 255 / 0.1);
    --n-hover: rgb(255 255 255 / 0.08);
    --n-shadow: rgb(2 8 24 / 0.5);
    --n-accent: var(--color-gold);
    --n-accent-fill: var(--color-gold);
    --n-accent-line: rgb(236 188 4 / 0.5);
    --n-accent-tint: rgb(236 188 4 / 0.13);
    --n-accent-glow: rgb(236 188 4 / 0.28);
  }
  .nav-bar {
    padding-top: max(1rem, env(safe-area-inset-top));
    padding-bottom: 1rem;
    transition: padding 0.6s var(--ease-expo);
  }
  /* Without JavaScript the bar never condenses, so give it a solid backing. */
  :global(html:not(.js)) .nav-bar {
    background: var(--n-solid);
  }
  .nav[data-condensed] .nav-bar {
    padding-top: max(0.7rem, env(safe-area-inset-top));
    padding-bottom: 0.7rem;
  }
  /* Inner pages are mostly text: once condensed, the bar gets a dark glass
     backing so copy never shows through behind the logo. */
  :global(html[data-page='inner']) .nav-bar {
    transition:
      padding 0.6s var(--ease-expo),
      background-color 0.5s ease;
  }
  :global(html[data-page='inner']) .nav[data-condensed] .nav-bar {
    background-color: rgb(4 10 22 / 0.8);
    backdrop-filter: blur(16px) saturate(1.3);
  }
  /* A gold hairline fades in under the bar once it condenses. */
  .nav::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(72rem, 86vw);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--n-accent-line) 25%, var(--n-accent-fill) 50%, var(--n-accent-line) 75%, transparent);
    transform: translateX(-50%) scaleX(0.2);
    opacity: 0;
    transition:
      opacity 0.7s var(--ease-expo),
      transform 0.9s var(--ease-expo);
    pointer-events: none;
  }
  .nav[data-condensed]::after {
    opacity: 0.7;
    transform: translateX(-50%) scaleX(1);
  }
  .nav-muted {
    color: var(--n-muted);
  }
  .nav-word {
    display: inline-block;
    max-width: 9rem;
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 0.7s var(--ease-expo),
      opacity 0.5s var(--ease-expo);
  }
  .nav[data-condensed] .nav-word {
    max-width: 0;
    opacity: 0;
  }

  /* ── Pill ── */
  .nav-pill {
    gap: 0.15rem;
    padding: 0.32rem;
    border-radius: 999px;
    background: var(--n-glass);
    box-shadow:
      0 12px 32px -18px var(--n-shadow),
      0 0 28px -10px var(--n-accent-glow);
    backdrop-filter: blur(18px) saturate(1.4);
  }
  /* Gold gradient hairline around the pill; a highlight drifts slowly round it. */
  .nav-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: conic-gradient(from var(--n-sweep, 0deg), var(--n-accent-line), color-mix(in srgb, var(--color-gold-glow) 95%, transparent) 12%, var(--n-accent-line) 26%, color-mix(in srgb, var(--color-gold) 25%, transparent) 50%, var(--n-accent-line) 75%, var(--n-accent-line));
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: nav-sweep 9s linear infinite;
    pointer-events: none;
  }
  @keyframes nav-sweep {
    to {
      --n-sweep: 360deg;
    }
  }
  .nav-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.58rem 1rem;
    border-radius: 999px;
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--n-fg);
    opacity: 0.78;
    transition: opacity 0.35s var(--ease-expo);
  }
  .nav-link:hover,
  .nav-link[aria-expanded='true'],
  .nav-link[data-active] {
    opacity: 1;
  }
  .nav-link[data-active] {
    color: var(--n-accent);
  }
  .nav-chev {
    width: 9px;
    height: 6px;
    opacity: 0.6;
    transition:
      transform 0.45s var(--ease-expo),
      opacity 0.3s;
  }
  .nav-link[aria-expanded='true'] .nav-chev {
    transform: rotate(180deg);
    opacity: 1;
    color: var(--n-accent);
  }
  /* Active section: a short gold rule that grows in under the label. */
  .nav-dot {
    position: absolute;
    left: 50%;
    bottom: 0.28rem;
    width: 16px;
    height: 2px;
    margin-left: -8px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-gold-glow), var(--n-accent-fill));
    box-shadow: 0 0 8px var(--n-accent-glow);
    transform: scaleX(0);
    transition: transform 0.6s var(--ease-expo);
  }
  .nav-link[data-active] .nav-dot {
    transform: scaleX(1);
  }
  /* Hover highlight that glides between links (positioned by nav.ts). */
  .nav-hover {
    position: absolute;
    top: 0.32rem;
    bottom: 0.32rem;
    left: 0;
    width: 0;
    border-radius: 999px;
    background: var(--n-accent-tint);
    box-shadow: inset 0 0 0 1px var(--n-accent-line);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-expo);
  }

  /* ── Flyout ── */
  .nav-flyout {
    position: absolute;
    top: calc(100% + 0.9rem);
    left: 0;
    border-radius: 1.4rem;
    background:
      radial-gradient(120% 60% at 50% 0%, var(--n-accent-tint), transparent 60%),
      var(--n-solid);
    box-shadow:
      inset 0 0 0 1px var(--n-accent-line),
      0 30px 60px -24px var(--n-shadow),
      0 0 40px -16px var(--n-accent-glow);
    backdrop-filter: blur(24px) saturate(1.4);
    opacity: 0;
    pointer-events: none;
    transform: translateY(8px) scale(0.98);
    transform-origin: 50% 0;
    transition:
      opacity 0.35s var(--ease-expo),
      transform 0.5s var(--ease-expo);
  }
  .nav-flyout[data-open] {
    opacity: 1;
    pointer-events: auto;
    transform: none;
  }
  .nav-flyout-clip {
    overflow: hidden;
    border-radius: inherit;
  }
  .nav-flyout-arrow {
    position: absolute;
    top: -5px;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--n-solid);
    box-shadow: -1px -1px 0 0 var(--n-accent-line);
    transform: rotate(45deg);
  }
  .nav-pane {
    padding: 1.35rem 1.4rem 1.25rem;
    width: max-content;
  }
  .nav-pane[hidden] {
    display: none;
  }
  .nav-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--n-accent);
    margin-bottom: 0.8rem;
  }
  .nav-eyebrow::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--n-accent-line), transparent);
  }
  .nav-grid {
    display: grid;
    gap: 0.1rem;
  }
  .nav-cols {
    display: grid;
    grid-template-columns: repeat(2, 20.5rem);
    column-gap: 1.25rem;
  }
  .nav-item-icon {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    place-items: center;
    border-radius: 0.55rem;
    color: var(--n-accent);
    background: var(--n-accent-tint);
  }
  .nav-item-icon :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .nav-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
    border-radius: 0.85rem;
    padding: 0.75rem 0.85rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--n-fg);
    background: var(--n-accent-tint);
    transition: background-color 0.3s var(--ease-expo);
  }
  .nav-all :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--n-accent);
    transition: transform 0.4s var(--ease-expo);
  }
  .nav-all:hover :global(svg) {
    transform: translateX(3px);
  }
  .nav-skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 2;
    border-radius: 0.6rem;
    padding: 0.6rem 0.9rem;
    font-weight: 700;
    color: var(--color-navy);
    background: var(--color-white);
    transition: top 0.3s var(--ease-expo);
  }
  .nav-skip:focus {
    top: 1rem;
  }
  .nav-sheet-cols {
    display: grid;
    gap: 1.25rem;
    padding-bottom: 1rem;
  }
  .nav-sheet-eyebrow {
    margin-bottom: 0.2rem;
    padding-left: 2.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--n-accent);
  }
  .nav-grid-2 {
    grid-template-columns: repeat(2, 19rem);
    width: auto;
    column-gap: 0.5rem;
  }
  .nav-grid > li {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--ease-expo),
      transform 0.5s var(--ease-expo);
    transition-delay: calc(var(--i) * 30ms);
  }
  .nav-pane[data-shown] .nav-grid > li {
    opacity: 1;
    transform: none;
  }
  .nav-item {
    position: relative;
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0.65rem;
    align-items: start;
    padding: 0.55rem 0.7rem;
    border-radius: 0.85rem;
    transition: background-color 0.3s var(--ease-expo);
  }
  /* A short gold bar slides in at the left edge of the hovered item. */
  .nav-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 2px;
    border-radius: 2px;
    background: var(--n-accent-fill);
    transform: scaleY(0);
    transition: transform 0.45s var(--ease-expo);
  }
  .nav-item:hover,
  .nav-item:focus-visible {
    background: var(--n-accent-tint);
  }
  .nav-item:hover::before,
  .nav-item:focus-visible::before {
    transform: scaleY(1);
  }
  .nav-item-index {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    padding-top: 0.2rem;
    color: var(--n-accent);
    opacity: 0.7;
    transition: color 0.3s;
  }
  .nav-item:hover .nav-item-index {
    opacity: 1;
  }
  .nav-item-title {
    display: block;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .nav-item-body {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--n-muted);
  }

  /* ── CTA: glass pill with a gold chip; gold sweeps across on hover. ── */
  .nav-cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.36rem 0.4rem 0.36rem 1.1rem;
    border-radius: 999px;
    overflow: hidden;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-navy);
    background: linear-gradient(100deg, var(--color-gold-glow) -30%, var(--color-gold) 50%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.45),
      inset 0 0 0 1px color-mix(in srgb, var(--color-gold-ink) 45%, transparent),
      0 10px 28px -10px var(--n-accent-glow),
      0 12px 32px -18px var(--n-shadow);
    transition:
      color 0.45s var(--ease-expo),
      box-shadow 0.45s var(--ease-expo);
  }
  .nav-cta:hover {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      inset 0 0 0 1px color-mix(in srgb, var(--color-gold-ink) 60%, transparent),
      0 14px 36px -10px color-mix(in srgb, var(--color-gold) 55%, transparent),
      0 12px 32px -18px var(--n-shadow);
  }
  /* The bar CTA hides on phones (the menu sheet carries its own). */
  @media (max-width: 639px) {
    .nav-cta-bar {
      display: none;
    }
  }
  /* A soft white glint sweeps across the gold on hover. */
  .nav-cta-fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgb(255 255 255 / 0.55) 48%, transparent 66%);
    transform: translateX(-110%);
    transition: transform 0.9s var(--ease-expo);
  }
  .nav-cta:hover .nav-cta-fill {
    transform: translateX(110%);
  }
  .nav-cta-chip {
    position: relative;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--color-navy);
    color: var(--color-gold);
    transition:
      transform 0.6s var(--ease-expo),
      background-color 0.4s;
  }
  .nav-cta-chip svg {
    width: 0.8rem;
    height: 0.8rem;
  }
  .nav-cta:hover .nav-cta-chip {
    transform: rotate(45deg);
  }

  /* ── Burger (below desktop only) ── */
  .nav-burger {
    position: relative;
