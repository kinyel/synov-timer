---
/**
 * Closing call to action and the footer: a sitemap, contact details with copy
 * buttons, and the fine print.
 */
import { SITE } from '../../data/site';
import { DELIVERY, PLATFORM } from '../../data/services';
import Icon from '../ui/Icon.astro';

interface Props {
  /** Show the "Talk to an architect" band above the footer. */
  cta?: boolean;
}
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
const company = [
  { label: 'About', href: '/about/' },
  { label: 'Careers', href: '/about/#careers' },
  { label: 'Case studies', href: '/case-studies/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Glossary', href: '/glossary/' },
  { label: 'TCPWave integration', href: '/solutions/tcpwave/' },
  { label: 'Contact', href: '/contact/' },
];
---

{
  cta && (
    <section class="cta-band" data-theme="dark" aria-labelledby="cta-band-title">
      <div class="cta-glow" aria-hidden="true" />
      <div class="gutter cta-inner">
        <p class="eyebrow">Start a conversation</p>
        <h2 id="cta-band-title" class="cta-title" data-reveal>
          Let’s architect <span class="text-lit">your empire.</span>
        </h2>
        <p class="cta-lead" data-reveal>
          Tell us where your ServiceNow platform is today and where you want it to go. A certified architect will get back to you.
        </p>
        <div class="cta-actions" data-reveal>
          <a href="/contact/" class="btn btn-primary" data-magnetic>
            Talk to an architect
            <Icon name="arrowUpRight" />
          </a>
          <a href={`mailto:${SITE.email}`} class="btn btn-outline">
            {SITE.email}
          </a>
        </div>
      </div>
    </section>
  )
}

<footer class="site-footer" data-theme="dark">
  <div class="gutter footer-grid">
    <div class="footer-brand">
      <a href="/" class="flex w-fit items-center gap-3" aria-label="Raleston Consulting, home">
        <img src="/brand/mark.svg" alt="" width="40" height="34" class="h-9 w-auto" loading="lazy" />
        <span class="text-[1.1rem] leading-[1.05] font-bold">Raleston<br /><span class="font-normal text-grey-400">Consulting</span></span>
      </a>
      <p class="mt-5 max-w-[22rem] text-[0.95rem] leading-relaxed text-grey-400">
        Certified ServiceNow architects in Ottawa, Canada. We design, build, connect and support ServiceNow platforms that stay easy to upgrade.
      </p>
      <ul class="footer-contact">
        <li>
          <Icon name="mail" />
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <button type="button" class="copy" data-copy={SITE.email} aria-label="Copy email address"><Icon name="copy" /></button>
        </li>
        <li>
          <Icon name="phone" />
          <a href={`tel:${SITE.tel}`}>{SITE.phone}</a>
          <button type="button" class="copy" data-copy={SITE.phone} aria-label="Copy phone number"><Icon name="copy" /></button>
        </li>
        <li><Icon name="pin" /><span>{SITE.city}, {SITE.countryName}</span></li>
      </ul>
    </div>
    <nav class="footer-cols" aria-label="Footer">
      <div>
        <p class="footer-head">Platform</p>
        <ul>{PLATFORM.map((s) => <li><a href={`/services/${s.slug}/`}>{s.short === s.name ? s.name : `${s.short}`}</a></li>)}</ul>
      </div>
      <div>
        <p class="footer-head">Delivery</p>
        <ul>
          {DELIVERY.map((s) => <li><a href={`/services/${s.slug}/`}>{s.name}</a></li>)}
          <li><a href="/services/">All services</a></li>
        </ul>
      </div>
      <div>
        <p class="footer-head">Company</p>
        <ul>{company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    </nav>
  </div>
  <div class="gutter footer-base">
    <p>© {year} {SITE.name}. {SITE.city}, {SITE.countryName}.</p>
    <p>ServiceNow and its product names are trademarks of ServiceNow, Inc. Raleston Consulting is an independent consultancy.</p>
  </div>
</footer>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 12vw, 9rem);
    color: var(--color-white);
    background: var(--color-night);
    text-align: center;
  }
  .cta-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 70% at 50% 100%, color-mix(in srgb, var(--color-iris) 45%, transparent), transparent 70%),
      radial-gradient(30% 50% at 15% 20%, color-mix(in srgb, var(--color-violet) 18%, transparent), transparent 70%),
      radial-gradient(30% 50% at 85% 20%, color-mix(in srgb, var(--color-azure) 14%, transparent), transparent 70%);
  }
  .cta-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cta-title {
    margin-top: 1.1rem;
    max-width: 18ch;
    font-size: clamp(2.4rem, 6vw, 5rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.012em;
  }
  .cta-lead {
    margin-top: 1.25rem;
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-grey-200);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .site-footer {
    color: var(--color-white);
    background: var(--color-black);
    border-top: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
  }
  .footer-grid {
    display: grid;
    gap: 3rem;
    padding-block: 4.5rem 3rem;
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    }
  }
  .footer-contact {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
  .footer-contact li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.98rem;
    color: var(--color-grey-200);
  }
  .footer-contact :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
    color: var(--color-iris-soft);
  }
  .footer-contact a:hover {
    color: var(--color-white);
  }
  .copy {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    margin: -0.6rem 0;
    place-items: center;
    border-radius: 0.6rem;
    color: var(--color-grey-400);
    transition:
      color 0.3s,
      background-color 0.3s;
  }
  .copy:hover {
    color: var(--color-white);
    background: color-mix(in srgb, var(--color-white) 8%, transparent);
  }
  .copy[data-copied] {
    color: var(--color-iris-soft);
  }
  .footer-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 2rem;
  }
  .footer-head {
    margin-bottom: 0.9rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .footer-cols li a {
    display: inline-block;
    padding-block: 0.35rem;
    font-size: 0.98rem;
    color: var(--color-grey-200);
    transition: color 0.3s;
  }
  .footer-cols li a:hover {
    color: var(--color-white);
  }
  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem 2rem;
    font-size: 0.85rem;
    color: var(--color-grey-400);
    border-top: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
  }
</style>
