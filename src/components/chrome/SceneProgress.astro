---
import { SCENES } from '../../lib/store';
---

<aside
  class="nav-ink gutter pointer-events-none fixed right-0 bottom-0 z-40 hidden items-center gap-3 pb-[max(1.25rem,env(safe-area-inset-bottom))] opacity-0 md:flex"
  aria-label="Section progress"
  data-progress
>
  <span class="label tabular-nums opacity-60"><span data-progress-index>01</span> / {String(SCENES.length).padStart(2, '0')}</span>
  <span class="relative h-px w-24 overflow-hidden bg-current/25"><span class="absolute inset-0 origin-left scale-x-0 bg-gold" data-progress-bar></span></span>
  <span class="label min-w-[10ch]" data-progress-label aria-live="polite">{SCENES[0].label}</span>
</aside>

<style>
  .nav-ink {
    color: var(--color-snow);
    transition: color 0.5s var(--ease-expo);
  }
  :global(html[data-theme='light']) .nav-ink {
    color: var(--color-ink);
  }
</style>
