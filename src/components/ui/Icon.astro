---
import { ICONS, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
  /** Visible label for screen readers; omit for decorative icons. */
  label?: string;
}
const { name, class: className, label } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  class:list={['icon', className]}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={ICONS[name]}
/>
