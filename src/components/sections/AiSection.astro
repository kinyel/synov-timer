---
/**
 * 02 · AI in the work. A 3D model of where AI sits: a violet AI layer floats
 * over your records and reaches down to work on them, one at a time, while
 * AI Control Tower watches from above. Beside it, the four pieces in a line
 * each. Violet is the AI colour throughout.
 */
import Icon from '../ui/Icon.astro';
import { blk } from '../../lib/iso';

const pieces = [
  { name: 'ServiceNow Otto', tag: 'Formerly Now Assist', line: 'Summaries, drafts and answers, built in' },
  { name: 'Skills', tag: 'AI Skill Kit', line: 'Your prompts, your approved model' },
  { name: 'AI agents', tag: 'AI Agent Studio', line: 'Multi-step work, within limits you set' },
  { name: 'MCP', tag: 'Model Context Protocol', line: 'Context from your other tools, governed' },
];
// A 4 × 4 field of records. The AI works on these, in this order.
const grid = [-123, -41, 41, 123];
const records = grid.flatMap((y) => grid.map((x) => ({ x, y })));
const work = [5, 14, 2, 11, 7, 12];
---

<section id="ai" class="section ai" data-scene="ai" data-theme="dark" aria-labelledby="ai-title">
  <div class="ai-glow" aria-hidden="true"></div>
  <div class="gutter relative ai-grid">
    <div class="ai-head">
      <p class="ai-eyebrow"><span class="badge badge-ai">AI</span> AI in the work</p>
      <h2 id="ai-title" class="h2 mt-4" data-reveal>AI that does <span class="ai-lit">real work</span></h2>
      <p class="lead mt-4 max-w-[30rem]" data-reveal>On data that is ready for it, with every action governed.</p>
    </div>

    <div class="s3d ai-scene" data-s3d aria-hidden="true">
      <div class="s3d-world">
        <span class="ai-pool"></span>
        <div class="blk ai-base" style={blk(0, 0, 360, 12)}>
          <b class="blk-top"><span class="ai-base-label">Your records</span></b>
          <b class="blk-e"></b>
          <b class="blk-s"></b>
        </div>
        {
          records.map((r, i) => {
            const n = work.indexOf(i);
            return (
              <div class={`blk ai-rec ${n >= 0 ? 'is-work' : ''}`} style={blk(r.x, r.y, 66, 8, 12, n >= 0 ? `--n:${n}` : '')}>
                <b class="blk-top">
                  <i />
                </b>
                <b class="blk-e" />
                <b class="blk-s" />
              </div>
            );
          })
        }
        {work.map((i, n) => <span class="ai-beam" style={`--x:${records[i]!.x}px;--y:${records[i]!.y}px;--n:${n}`} />)}
        <div class="blk ai-layer" style={blk(0, 0, 300, 5, 150)}>
          <b class="blk-top"><span class="ai-layer-label">ServiceNow Otto · AI agents</span></b>
          <b class="blk-e"></b>
          <b class="blk-s"></b>
        </div>
        <div class="ai-tower">
          <span>AI Control Tower</span>
        </div>
      </div>
    </div>

    <div class="ai-copy">
      <ul class="ai-list">
        {
          pieces.map((p) => (
            <li data-reveal>
              <span class="icon-tile is-ai is-sm">
                <Icon name="ai" />
              </span>
              <span class="ai-text">
                <b>
                  {p.name} <em>{p.tag}</em>
                </b>
                <span>{p.line}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <p class="ai-note" data-reveal>
        <Icon name="check" /> Every action checked and logged in AI Control Tower.
      </p>
    </div>
  </div>
</section>

<style>
  .ai {
    overflow: hidden;
    background: var(--color-night);
  }
  .ai-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(45% 45% at 75% 40%, color-mix(in srgb, var(--color-violet) 22%, transparent), transparent 70%),
      radial-gradient(40% 40% at 10% 70%, color-mix(in srgb, var(--color-iris) 16%, transparent), transparent 70%);
    pointer-events: none;
  }
  .ai-grid {
    display: grid;
    gap: 1rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .ai-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-areas: 'head scene' 'copy scene';
      grid-template-rows: auto 1fr;
      column-gap: 3rem;
    }
    .ai-head {
      grid-area: head;
      align-self: end;
    }
    .ai-scene {
      grid-area: scene;
    }
    .ai-copy {
      grid-area: copy;
      align-self: start;
    }
  }
  .ai-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-violet-soft);
  }
  .ai-lit {
    color: var(--color-violet-soft);
    text-shadow: 0 0 30px color-mix(in srgb, var(--color-violet) 70%, transparent);
  }

  /* ── The model ── */
  .ai-scene {
    --k: 0.6;
    --rx: 60deg;
    height: 380px;
  }
  @media (min-width: 640px) {
    .ai-scene {
      --k: 0.82;
      height: 480px;
    }
  }
  @media (min-width: 1280px) {
    .ai-scene {
      --k: 1;
      height: 580px;
    }
  }
  .ai-scene .s3d-world {
    top: 60%;
  }
  .ai-pool {
    position: absolute;
    left: -330px;
    top: -330px;
    width: 660px;
    height: 660px;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-violet) 26%, transparent), color-mix(in srgb, var(--color-iris) 10%, transparent) 55%, transparent);
    transform: translateZ(-2px);
  }
  .ai-base .blk-top {
    background:
      radial-gradient(60% 60% at 50% 50%, color-mix(in srgb, var(--color-iris) 18%, transparent), transparent 75%),
      color-mix(in srgb, var(--color-navy) 70%, var(--color-night));
  }
  .ai-base-label,
  .ai-layer-label {
    position: absolute;
    right: 12px;
    bottom: 9px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-iris-soft) 70%, transparent);
  }
  .ai-layer-label {
    color: var(--color-violet-soft);
  }
  /* Records rise into place. */
  .ai-rec {
    --q: clamp(0, calc(var(--p) * 1.6), 1);
    --dz: calc(var(--h) * (var(--q) - 1));
  }
  .ai-rec .blk-top i {
    position: absolute;
    left: 18%;
    right: 30%;
    top: 30%;
    height: 3px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--color-white) 18%, transparent);
    box-shadow: 0 9px 0 color-mix(in srgb, var(--color-white) 10%, transparent);
  }
  /* The record being worked on: violet while the AI acts, gold once done. */
  .ai-rec.is-work .blk-top::after {
    content: '';
    position: absolute;
    inset: 0;
    animation: ai-work 9s linear infinite;
    animation-delay: calc(var(--n) * 1.5s);
    opacity: 0;
  }
  @keyframes ai-work {
    0% {
      opacity: 0;
      box-shadow: inset 0 0 0 1.5px var(--color-violet), inset 0 0 18px color-mix(in srgb, var(--color-violet) 50%, transparent);
    }
    3%,
    11% {
      opacity: 1;
      box-shadow: inset 0 0 0 1.5px var(--color-violet), inset 0 0 18px color-mix(in srgb, var(--color-violet) 50%, transparent), 0 0 24px color-mix(in srgb, var(--color-violet) 60%, transparent);
    }
    14%,
    30% {
      opacity: 1;
      box-shadow: inset 0 0 0 1.5px var(--color-gold), inset 0 0 14px color-mix(in srgb, var(--color-gold) 30%, transparent);
    }
    40%,
    100% {
      opacity: 0;
      box-shadow: inset 0 0 0 1.5px var(--color-gold);
    }
  }
  /* A beam from the AI layer down to the record it is working on. */
  .ai-beam {
    position: absolute;
    left: calc(var(--x) - 1px);
    top: var(--y);
    width: 2px;
    height: 136px;
    transform-origin: 50% 0;
    transform: translateZ(150px) rotateX(-90deg);
    background: linear-gradient(180deg, var(--color-violet-soft), color-mix(in srgb, var(--color-violet) 60%, transparent));
    box-shadow: 0 0 12px 2px color-mix(in srgb, var(--color-violet) 70%, transparent);
    opacity: 0;
    animation: ai-beam 9s linear infinite;
    animation-delay: calc(var(--n) * 1.5s);
  }
  @keyframes ai-beam {
    0%,
    13%,
    100% {
      opacity: 0;
    }
    2%,
    10% {
      opacity: 1;
    }
  }
  /* The AI layer settles over the records as the section arrives. */
  .ai-layer {
    --dz: calc((1 - var(--p)) * 160px);
  }
  .ai-layer .blk-top {
    background:
      radial-gradient(65% 65% at 50% 50%, color-mix(in srgb, var(--color-violet) 22%, transparent), transparent 75%),
      linear-gradient(135deg, color-mix(in srgb, var(--color-white) 12%, transparent), transparent 60%),
      color-mix(in srgb, var(--color-violet) 10%, color-mix(in srgb, var(--color-night) 70%, transparent));
    box-shadow:
      inset 0 0 0 1.5px color-mix(in srgb, var(--color-violet-soft) 80%, transparent),
      0 0 50px color-mix(in srgb, var(--color-violet) 35%, transparent);
  }
  .ai-layer .blk-e,
  .ai-layer .blk-s {
    background: color-mix(in srgb, var(--color-violet) 40%, var(--color-night));
  }
  /* AI Control Tower: an outline above everything, watching. */
  .ai-tower {
    position: absolute;
    left: -170px;
    top: -170px;
    width: 340px;
    height: 340px;
    border: 1px dashed color-mix(in srgb, var(--color-iris-soft) 45%, transparent);
    transform: translateZ(calc(240px + (1 - var(--p)) * 200px));
  }
  .ai-tower span {
    position: absolute;
    left: 10px;
    top: 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-iris-soft) 80%, transparent);
  }

  /* ── The list ── */
  .ai-list {
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 9%, transparent);
  }
  .ai-list li {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-white) 9%, transparent);
  }
  .ai-text {
    display: grid;
    min-width: 0;
  }
  .ai-text b {
    font-size: 1.15rem;
    color: var(--color-white);
  }
  .ai-text em {
    margin-left: 0.4rem;
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-violet-soft);
  }
  .ai-text > span {
    font-size: 0.98rem;
    color: var(--color-grey-400);
  }
  .ai-note {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
    font-size: 0.98rem;
    color: var(--color-grey-200);
  }
  .ai-note :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-violet-soft);
  }
</style>
