---
/**
 * 06 · Impact. A dark page-only section (the canvas is clipped away here).
 * Gold-gradient counters count up with scroll; an outlined band reacts to
 * scroll speed; thin light streaks run behind everything.
 */
const stats = [
  { value: 40, label: 'faster deployment' },
  { value: 60, label: 'higher user adoption' },
];
const band = 'VALUE IN WEEKS, NOT MONTHS';
---

<section id="impact" data-scene="impact" data-theme="dark" class="relative overflow-hidden">
  <div class="layer-bg absolute inset-0" style="background: radial-gradient(80% 60% at 70% 30%, #111b4a 0%, #04060f 70%);" aria-hidden="true">
    <!-- Light streaks: thin gradient lines, speed tied to scroll velocity. -->
    {
      Array.from({ length: 9 }, (_, i) => (
        <span
          class="absolute left-0 h-px w-[38vw] opacity-60"
          style={`top:${8 + i * 10.5}%; background: linear-gradient(90deg, transparent, ${i % 3 === 0 ? 'rgb(255 194 26 / 0.85)' : 'rgb(143 230 255 / 0.55)'}, transparent);`}
          data-streak
        />
      ))
    }
  </div>

  <div class="layer-copy gutter py-28 text-white md:py-40">
    <p class="label text-[0.66rem] text-gold">Impact</p>
    <div class="mt-8 grid gap-10 md:grid-cols-2 md:gap-16">
      {
        stats.map((s) => (
          <div>
            <p class="font-display leading-[0.9] font-semibold tracking-[-0.04em] text-[clamp(4.5rem,13vw,10rem)]">
              <span class="bg-gradient-to-b from-gold-glow to-[#f2b200] bg-clip-text text-transparent tabular-nums" data-count={s.value}>
                {s.value}%
              </span>
            </p>
            <p class="mt-3 text-[1rem] text-muted md:text-lg">
              Up to <span class="text-white">{s.value}% {s.label}</span>
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="layer-copy overflow-hidden border-y border-white/10 py-5 md:py-7" aria-label="Value in weeks, not months">
    <div class="flex w-max gap-10 whitespace-nowrap will-change-transform" data-band aria-hidden="true">
      {
        Array.from({ length: 6 }, () => (
          <span class="font-display text-[clamp(2rem,5vw,4.2rem)] leading-none font-semibold tracking-[-0.03em] text-transparent [-webkit-text-stroke:1.2px_rgb(255_255_255/0.55)]">
            {band}
            <span class="mx-6 inline-block size-2.5 translate-y-[-0.25em] rounded-full bg-gold align-middle" />
          </span>
        ))
      }
    </div>
  </div>
  <div class="h-20 md:h-28"></div>
</section>
