---
/**
 * 03 · Expertise (pinned). The camera visits each expertise building in
 * turn; the subject gets a gold ground ring and a label with a leader line,
 * the rest of the model fades back, and an info card explains it. Then the
 * section turns dark and an x-ray scan sweeps down the whole model.
 */
import { EXPERTISE } from '../../lib/content';
const layers = EXPERTISE;
---

<section id="expertise" data-scene="expertise" data-theme="light" data-webgl="campus" data-feather="bottom" class="relative h-[620svh]">
  <div class="layer-bg absolute inset-0" style="background: linear-gradient(180deg, #eceff4 0%, #f3f5f8 100%);" aria-hidden="true"></div>
  <div class="layer-bg pointer-events-none sticky top-0 h-svh opacity-0" style="background: radial-gradient(90% 70% at 60% 40%, #101a46 0%, #04060f 75%);" aria-hidden="true" data-xray-bg>
    <!-- As the x-ray finishes, the backdrop warms into the staircase's black and gold, so the two sections meet with no seam. -->
    <div class="absolute inset-0 opacity-0" style="background: radial-gradient(70% 60% at 62% 52%, #1a1407 0%, #0b0a08 45%, #050506 100%);" data-xray-warm></div>
  </div>

  <div class="layer-copy pointer-events-none sticky top-0 -mt-[100svh] h-svh overflow-hidden" data-expertise-stage>
    <!-- Labels: positioned each frame at the projected roof point of their building. -->
    {
      layers.map((l, i) => (
        <div class="bldg-label" data-label={i} aria-hidden="true">
          <span class="bldg-dot" />
          <span class="bldg-line" />
          <span class="bldg-tag">
            <span class="bldg-name">
              <span class="max-sm:hidden">{l.name}</span>
              <span class="sm:hidden">{l.short}</span>
            </span>
            <span class="bldg-cap">{l.tag}</span>
          </span>
        </div>
      ))
    }

    <div class="gutter absolute inset-x-0 bottom-0 pb-[max(1rem,env(safe-area-inset-bottom))] md:pb-10">
      <div class="story-stack">
        {
          layers.map((l, i) => (
            <article class="story-card" data-exp-card={i} style="clip-path: inset(100% 0 0 0 round 1.4rem)">
              <p class="story-eyebrow">
                <span>{l.place}</span>
                <span class="num">0{i + 1} / 06</span>
              </p>
              <div>
                <h3 class="story-title">{l.name}</h3>
                <p class="story-body">{l.body}</p>
              </div>
            </article>
          ))
        }
        <article class="story-card is-dark" data-exp-card="6" style="clip-path: inset(100% 0 0 0 round 1.4rem)">
          <p class="story-eyebrow">
            <span>X-ray</span>
          </p>
          <div>
            <h3 class="story-title">Six practices. One platform.</h3>
            <p class="story-body">The scan shows what sits inside each building: shared data, common standards and the integrations that let six practices work as one.</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
