---
/**
 * 03 · Expertise (pinned). The camera visits each expertise building in
 * turn; the subject gets a gold ground ring and a label with a leader line,
 * the rest of the model fades back, and an info card explains it. Then the
 * section turns dark and an x-ray scan sweeps down the whole model.
 */
const layers = [
  { name: 'App Engine', short: 'App Engine', body: 'Custom applications built on the platform, from low-code to pro-code.' },
  { name: 'ITSM', short: 'ITSM', body: 'Service desk, incident, problem and change, designed to scale.' },
  { name: 'ITAM', short: 'ITAM', body: 'Hardware and software assets tracked across their whole lifecycle.' },
  { name: 'ITOM', short: 'ITOM', body: 'Discovery, service mapping and event management, end to end.' },
  { name: 'Integration', short: 'Integration', body: 'HR, Finance, ITSM and custom apps connected to eliminate silos.' },
  { name: 'Enterprise Architecture', short: 'Ent. Arch.', body: 'Roadmaps and structure that keep the platform clean as it grows.' },
];
---

<section id="expertise" data-scene="expertise" data-theme="light" data-webgl="campus" class="relative h-[620svh]">
  <div class="layer-bg absolute inset-0" style="background: linear-gradient(180deg, #eceff4 0%, #f3f5f8 100%);" aria-hidden="true"></div>
  <div class="layer-bg pointer-events-none sticky top-0 h-svh opacity-0" style="background: radial-gradient(90% 70% at 60% 40%, #101a46 0%, #04060f 75%);" aria-hidden="true" data-xray-bg></div>

  <div class="layer-copy pointer-events-none sticky top-0 -mt-[100svh] h-svh overflow-hidden" data-expertise-stage>
    <!-- Labels: positioned each frame at the projected roof point of their building. -->
    {
      layers.map((l, i) => (
        <div class="absolute top-0 left-0 opacity-0" data-label={i} aria-hidden="true">
          <span class="absolute -top-[3px] -left-[3px] size-1.5 rounded-full bg-gold" />
          <span class="absolute bottom-0 left-0 h-14 w-px origin-bottom bg-ink/40" data-label-line />
          <span class="label absolute bottom-14 left-0 -translate-x-1/2 rounded-full bg-ink px-3 py-1.5 text-[0.62rem] whitespace-nowrap text-white">
            <span class="max-sm:hidden">{l.name}</span>
            <span class="sm:hidden">{l.short}</span>
          </span>
        </div>
      ))
    }

    <div class="gutter absolute inset-x-0 bottom-0 pb-[max(1rem,env(safe-area-inset-bottom))] md:pb-10">
      <div class="relative h-[9.5rem] w-full max-w-[24rem] md:h-[11rem]">
        {
          layers.map((l, i) => (
            <article
              class="absolute inset-0 flex flex-col justify-between rounded-[1.4rem] border border-white/70 bg-white/80 p-5 text-ink shadow-[0_24px_60px_-30px_rgb(10_16_48/0.35)] backdrop-blur-xl md:p-6"
              data-exp-card={i}
              style="clip-path: inset(100% 0 0 0 round 1.4rem)"
            >
              <p class="label flex justify-between text-[0.66rem] text-ink/55">
                <span>Expertise</span>
                <span class="tabular-nums">0{i + 1} / 06</span>
              </p>
              <div>
                <h3 class="font-display text-[1.45rem] leading-[1.05] font-semibold tracking-[-0.02em] md:text-[1.7rem]">{l.name}</h3>
                <p class="mt-1.5 text-[0.85rem] leading-snug text-ink/70">{l.body}</p>
              </div>
            </article>
          ))
        }
        <article
          class="absolute inset-0 flex flex-col justify-between rounded-[1.4rem] border border-white/10 bg-deep/70 p-5 text-white backdrop-blur-xl md:p-6"
          data-exp-card="6"
          style="clip-path: inset(100% 0 0 0 round 1.4rem)"
        >
          <p class="label text-[0.66rem] text-cyan">X-ray</p>
          <div>
            <h3 class="font-display text-[1.45rem] leading-[1.05] font-semibold tracking-[-0.02em] md:text-[1.7rem]">Six layers. One platform.</h3>
            <p class="mt-1.5 text-[0.85rem] leading-snug text-muted">Every layer architected to work as one.</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
