---
/**
 * 03 · The foundation. Three plain boxes, one per practice (ITSM, ITOM,
 * ITAM), standing on one wide box: the CMDB they all rely on. Flat, no 3D.
 */
import { serviceBySlug } from '../../data/services';
import Icon from '../ui/Icon.astro';

const practices = [
  { s: serviceBySlug('itsm')!, line: 'Requests in, answers out.' },
  { s: serviceBySlug('itom')!, line: 'Know which alert matters, before users notice.' },
  { s: serviceBySlug('itam')!, line: 'What you own, what it costs, whether it is used.' },
];
---

<section id="foundation" class="section foundation" data-scene="foundation" data-theme="dark" aria-labelledby="foundation-title">
  <div class="gutter">
    <p class="eyebrow">The foundation</p>
    <h2 id="foundation-title" class="h2 mt-4" data-reveal>Three practices, <span class="text-lit">one foundation</span></h2>

    <ul class="f-boxes">
      {
        practices.map(({ s, line }) => (
          <li data-reveal>
            <a href={`/services/${s.slug}/`} class="card card-hover f-box">
              <span class="f-name">{s.short}</span>
              <span class="f-full">{s.name}</span>
              <span class="f-line">{line}</span>
              <Icon name="arrow" class="f-arrow" />
            </a>
          </li>
        ))
      }
      <li class="f-base-item" data-reveal>
        <a href="/services/cmdb/" class="card card-hover f-box f-base">
          <span class="f-name">CMDB</span>
          <span class="f-full">Configuration Management Database</span>
          <span class="f-line">The map of everything you run. All three stand on it.</span>
          <Icon name="arrow" class="f-arrow" />
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .foundation {
    background:
      radial-gradient(45% 50% at 80% 30%, color-mix(in srgb, var(--color-iris) 14%, transparent), transparent 70%),
      var(--color-night);
  }
  .f-boxes {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 720px) {
    .f-boxes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .f-base-item {
      grid-column: 1 / -1;
    }
  }
  .f-boxes > li {
    display: flex;
  }
  .f-box {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.35rem;
    padding: clamp(1.4rem, 2.6vw, 2rem);
  }
  .f-name {
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    font-weight: 800;
    line-height: 1;
    color: var(--color-white);
  }
  .f-full {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .f-line {
    margin-top: 0.6rem;
    padding-right: 2rem;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-grey-200);
  }
  .f-box :global(.f-arrow) {
    position: absolute;
    right: clamp(1.4rem, 2.6vw, 2rem);
    bottom: clamp(1.4rem, 2.6vw, 2rem);
    width: 1.2rem;
    height: 1.2rem;
    color: var(--color-iris-soft);
    transition: transform 0.4s var(--ease-expo);
  }
  .f-box:hover :global(.f-arrow),
  .f-box:focus-visible :global(.f-arrow) {
    transform: translateX(4px);
  }
  /* The CMDB: the wide box underneath, in the data colour. */
  .f-base {
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-azure) 14%, transparent), transparent 70%),
      color-mix(in srgb, var(--color-navy) 55%, var(--color-night));
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-azure) 40%, transparent),
      0 30px 60px -40px color-mix(in srgb, var(--color-azure) 60%, transparent);
  }
  .f-base .f-full {
    color: var(--color-azure);
  }
</style>
