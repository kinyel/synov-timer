---
/** 09 · FAQ: the questions executives ask, with real answers. */
import { HOME_FAQS } from '../../data/faqs';
import Faq from '../ui/Faq.astro';
---

<section id="faq" class="section faq-section" data-scene="faq" data-theme="dark" aria-labelledby="faq-title">
  <div class="gutter faq-wrap">
    <div>
      <p class="eyebrow">Questions</p>
      <h2 id="faq-title" class="h2 mt-4" data-reveal>What executives <span class="text-lit">ask&nbsp;us</span></h2>
      <a href="/contact/" class="link-arrow mt-6" data-reveal>Ask your own question <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </div>
    <Faq items={HOME_FAQS} />
  </div>
</section>

<style>
  .faq-section {
    background:
      radial-gradient(40% 50% at 0% 50%, color-mix(in srgb, var(--color-violet) 12%, transparent), transparent 70%),
      var(--color-night);
  }
  .faq-wrap {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .faq-wrap {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>
