---
/**
 * 08 · Why Raleston. The kinetic "master craftsmen / not just configurators"
 * type drifts behind. In front, a cube of 27 glass blocks assembles itself as
 * the section arrives, corners last, and a thread of gold light rises out of
 * it: designed before it is configured. Beside it, the two measured outcomes
 * and four short reasons.
 */
import { SITE } from '../../data/site';
import Icon from '../ui/Icon.astro';

const reasons = ['Architect-led, start to finish', 'Designed before anything is configured', 'Out of the box first, so upgrades stay easy', 'Delivered in stages you can use'];
// 3 × 3 × 3 blocks. --d is how far each sits from the centre: corners assemble last.
const cubes = [-1, 0, 1].flatMap((gz) => [-1, 0, 1].flatMap((gy) => [-1, 0, 1].map((gx) => ({ gx, gy, gz, d: Math.abs(gx) + Math.abs(gy) + Math.abs(gz) }))));
---

<section id="why" class="section why" data-scene="why" data-theme="dark" aria-labelledby="why-title">
  <div class="why-kinetic" aria-hidden="true">
    <p class="kin kin-a" data-kinetic-a>MASTER CRAFTSMEN · MASTER CRAFTSMEN ·</p>
    <p class="kin kin-b" data-kinetic-b>NOT JUST CONFIGURATORS · NOT JUST CONFIGURATORS ·</p>
  </div>

  <div class="gutter relative why-grid">
    <div class="why-head">
      <p class="eyebrow">Why Raleston</p>
      <h2 id="why-title" class="h2 mt-4" data-reveal>Master craftsmen, <span class="text-lit">not just configurators</span></h2>
    </div>

    <div class="s3d why-scene" data-s3d aria-hidden="true">
      <div class="s3d-world">
        <span class="why-pool"></span>
        {
          cubes.map((c) => (
            <div class="blk why-cube" style={`--gx:${c.gx};--gy:${c.gy};--gz:${c.gz};--d:${c.d}`}>
              <b class="blk-top" />
              <b class="blk-e" />
              <b class="blk-s" />
            </div>
          ))
        }
        <span class="why-beam"></span>
      </div>
    </div>

    <div class="why-copy">
      <dl class="why-stats" data-reveal>
        {
          SITE.stats.map((s) => (
            <div class="card">
              <dt>{s.label}</dt>
              <dd>
                <span>Up to</span> {s.value}
              </dd>
            </div>
          ))
        }
      </dl>
      <ul class="why-reasons">
        {
          reasons.map((r) => (
            <li data-reveal>
              <Icon name="check" />
              {r}
            </li>
          ))
        }
      </ul>
      <a href="/about/" class="link-arrow mt-6" data-reveal>About Raleston <Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .why {
    overflow: hidden;
    background:
      radial-gradient(45% 45% at 75% 45%, color-mix(in srgb, var(--color-iris) 20%, transparent), transparent 70%),
      var(--color-night);
  }
  .why-kinetic {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    pointer-events: none;
    opacity: 0.9;
  }
  .kin {
    font-size: clamp(4rem, 12vw, 11rem);
    font-weight: 600;
    line-height: 0.9;
    white-space: nowrap;
    will-change: transform;
  }
  .kin-a {
    color: color-mix(in srgb, var(--color-white) 4%, transparent);
  }
  .kin-b {
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--color-iris-soft) 22%, transparent);
  }
  .why-grid {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-areas: 'head scene' 'copy scene';
      grid-template-rows: auto 1fr;
      column-gap: 3rem;
    }
    .why-head {
      grid-area: head;
      align-self: end;
    }
    .why-scene {
      grid-area: scene;
    }
    .why-copy {
      grid-area: copy;
      align-self: start;
    }
  }

  /* ── The cube ── */
  .why-scene {
    --k: 0.62;
    height: 360px;
  }
  @media (min-width: 640px) {
    .why-scene {
      --k: 0.85;
      height: 460px;
    }
  }
  @media (min-width: 1280px) {
    .why-scene {
      --k: 1;
      height: 540px;
    }
  }
  .why-scene .s3d-world {
    top: 58%;
  }
  .why-pool {
    position: absolute;
    left: -300px;
    top: -300px;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-iris) 28%, transparent), color-mix(in srgb, var(--color-violet) 8%, transparent) 60%, transparent);
    transform: translateZ(-112px);
  }
  /* Each block flies in from an exploded position; the farther from the centre, the later. */
  .why-cube {
    --w: 70px;
    --h: 70px;
    --q: clamp(0, calc(var(--p) * 1.45 - var(--d) * 0.15), 1);
    --e: calc((1 - var(--q)) * (1 - var(--q)) * 70px);
    --x: calc(var(--gx) * (72px + var(--e)));
    --y: calc(var(--gy) * (72px + var(--e)));
    --z: calc(var(--gz) * 72px - 35px + var(--gz) * var(--e));
  }
  .why-cube .blk-top {
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--color-white) 20%, transparent), color-mix(in srgb, var(--color-white) 5%, transparent) 60%),
      color-mix(in srgb, var(--color-iris) 26%, var(--color-navy));
  }
  .why-cube .blk-e {
    background: linear-gradient(90deg, color-mix(in srgb, var(--color-iris) 18%, var(--color-indigo)), var(--color-night));
  }
  .why-cube .blk-s {
    background: linear-gradient(180deg, color-mix(in srgb, var(--color-iris) 30%, var(--color-navy)), color-mix(in srgb, var(--color-indigo) 80%, var(--color-night)));
  }
  /* The centre column carries the gold thread once the cube is whole. */
  .why-beam {
    position: absolute;
    left: -1.5px;
    top: 0;
    width: 3px;
    height: 230px;
    transform-origin: 50% 0;
    transform: translateZ(108px) rotateX(90deg) scaleY(clamp(0, calc(var(--p) * 3 - 2), 1));
    background: linear-gradient(180deg, var(--color-gold), var(--color-gold-glow) 30%, transparent);
    box-shadow: 0 0 14px 2px color-mix(in srgb, var(--color-gold) 70%, transparent);
  }

  /* ── The copy ── */
  .why-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .why-stats > div {
    display: flex;
    flex-direction: column-reverse;
    min-width: 10rem;
    padding: 1rem 1.15rem;
  }
  .why-stats dt {
    margin-top: 0.25rem;
    font-size: 0.92rem;
    color: var(--color-grey-200);
  }
  .why-stats dd {
    font-size: 2.3rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: lining-nums;
  }
  .why-stats dd span {
    margin-right: 0.15rem;
    font-size: 0.4em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    vertical-align: 0.45em;
    color: var(--color-iris-soft);
  }
  .why-reasons {
    display: grid;
    gap: 0.7rem;
    margin-top: 1.75rem;
  }
  .why-reasons li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 1.08rem;
    color: var(--color-white);
  }
  .why-reasons :global(svg) {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    color: var(--color-iris-soft);
  }
</style>
