---
/**
 * 05 · Industries (pinned). A floating model city in the sky. The camera
 * descends through clouds and visits each district while the light runs from
 * day to golden hour to dusk; the sky behind (z 0, under the canvas) follows.
 */
import { DISTRICTS } from '../../webgl/scenes/city/districts';
const items = DISTRICTS.map(({ name, short, place, tag, body }) => ({ name, short, place, tag, body }));
---

<section id="industries" data-scene="industries" data-theme="dark" data-webgl="city" data-feather="top" class="relative h-[760svh]">
  <div class="layer-bg pointer-events-none sticky top-0 h-svh" style="background: linear-gradient(180deg, #e7f0fb 0%, #f6f9fc 100%);" aria-hidden="true" data-sky>
    <!-- Arrival veil: carries the staircase's black into the sky, then dissolves
         as the camera comes down through the clouds into daylight. -->
    <div class="absolute inset-0" style="background: linear-gradient(180deg, #070707 0%, #0b0a09 38%, rgb(11 10 9 / 0.55) 66%, transparent 100%);" data-sky-veil></div>
  </div>

  <div class="layer-copy pointer-events-none sticky top-0 -mt-[100svh] h-svh overflow-hidden">
    {
      items.map((d, i) => (
        <div class="bldg-label" data-city-label={i} aria-hidden="true">
          <span class="bldg-dot" />
          <span class="bldg-line" />
          <span class="bldg-tag">
            <span class="bldg-name">
              <span class="max-sm:hidden">{d.name}</span>
              <span class="sm:hidden">{d.short}</span>
            </span>
            <span class="bldg-cap">{d.tag}</span>
          </span>
        </div>
      ))
    }
    <div class="gutter absolute inset-x-0 bottom-0 pb-[max(1rem,env(safe-area-inset-bottom))] md:pb-10">
      <div class="story-stack">
        <article class="story-card" data-city-card="0" style="clip-path: inset(100% 0 0 0 round 1.4rem)">
          <p class="story-eyebrow"><span>Industries</span></p>
          <div>
            <h3 class="story-title">Six districts. One platform.</h3>
            <p class="story-body">Each district is a sector we work in. The gold lines are the integrations that tie every one of them back to the same core platform.</p>
          </div>
        </article>
        {
          items.map((d, i) => (
            <article class="story-card" data-city-card={i + 1} style="clip-path: inset(100% 0 0 0 round 1.4rem)">
              <p class="story-eyebrow">
                <span>{d.place}</span>
                <span class="num">0{i + 1} / 06</span>
              </p>
              <div>
                <h3 class="story-title">{d.name}</h3>
                <p class="story-body">{d.body}</p>
              </div>
            </article>
          ))
        }
        <article class="story-card is-dark" data-city-card="7" style="clip-path: inset(100% 0 0 0 round 1.4rem)">
          <p class="story-eyebrow"><span>Industries</span></p>
          <div>
            <h3 class="story-title">Every district, connected.</h3>
            <p class="story-body">At dusk the whole city is lit by the same network: one platform, governed once, serving every sector on it.</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
