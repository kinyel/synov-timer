---
/**
 * 07 · Industries. Six square glass panels stand in a ring on one platform
 * and turn as the page scrolls, bringing each sector to the front in turn.
 * The CMDB sits at the centre: one data model under every sector.
 */
import { INDUSTRIES } from '../../data/industries';
import Icon from '../ui/Icon.astro';

const step = 360 / INDUSTRIES.length;
---

<section id="industries" class="section industries" data-scene="industries" data-theme="dark" aria-labelledby="industries-title">
  <div class="gutter ind-grid">
    <div class="ind-head">
      <p class="eyebrow">Industries</p>
      <h2 id="industries-title" class="h2 mt-4" data-reveal>Six sectors, <span class="text-lit">one platform</span></h2>
      <p class="lead mt-4 max-w-[28rem]" data-reveal>The same platform, shaped to what each sector needs.</p>
    </div>

    <div class="s3d ind-scene" data-s3d data-s3d-start="top bottom" data-s3d-end="bottom top" aria-hidden="true">
      <div class="ind-world">
        <div class="ind-floor"><span>One platform</span></div>
        <div class="ind-core"><i></i><i></i><i></i><b>CMDB</b></div>
        {
          INDUSTRIES.map((ind, i) => (
            <div class="ind-panel" style={`--i:${i};--a:${i * step}deg`}>
              <div class="ind-front">
                <Icon name={ind.icon} />
                <b>{ind.name}</b>
                <span>{ind.line}</span>
              </div>
              <div class="ind-back" />
            </div>
          ))
        }
      </div>
    </div>

    <ul class="ind-chips">
      {
        INDUSTRIES.map((ind) => (
          <li data-reveal>
            <span class="icon-tile is-sm">
              <Icon name={ind.icon} />
            </span>
            <span>
              <b>{ind.name}</b>
              <span class="ind-line">{ind.line}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .industries {
    overflow: hidden;
    background:
      radial-gradient(45% 40% at 10% 20%, color-mix(in srgb, var(--color-violet) 14%, transparent), transparent 70%),
      radial-gradient(40% 40% at 80% 55%, color-mix(in srgb, var(--color-azure) 12%, transparent), transparent 70%),
      var(--color-night);
  }
  .ind-grid {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .ind-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      grid-template-areas: 'head scene' 'chips scene';
      grid-template-rows: auto 1fr;
      column-gap: 3rem;
    }
    .ind-head {
      grid-area: head;
      align-self: end;
    }
    .ind-scene {
      grid-area: scene;
    }
    .ind-chips {
      grid-area: chips;
      align-self: start;
    }
  }

  /* ── The ring ── */
  .ind-scene {
    --r: 250px;
    --pw: 190px;
    height: 400px;
    perspective: 1300px;
    perspective-origin: 50% 20%;
  }
  @media (max-width: 639px) {
    .ind-scene {
      --r: 150px;
      --pw: 128px;
      height: 300px;
    }
  }
  @media (min-width: 1280px) {
    .ind-scene {
      height: 520px;
    }
  }
  .ind-world {
    position: absolute;
    left: 50%;
    top: 46%;
    transform-style: preserve-3d;
    transform: rotateX(calc(-10deg + var(--ty))) rotateY(calc(var(--p) * -300deg + 18deg + var(--tx)));
  }
  .ind-world * {
    transform-style: preserve-3d;
  }
  /* The platform the panels stand on. */
  .ind-floor {
    position: absolute;
    left: calc(var(--r) * -1.45);
    top: calc(var(--r) * -1.45);
    width: calc(var(--r) * 2.9);
    height: calc(var(--r) * 2.9);
    transform: translateY(calc(var(--pw) / 2 + 2px)) rotateX(90deg);
    background:
      linear-gradient(to right, color-mix(in srgb, var(--color-iris-soft) 9%, transparent) 1px, transparent 1px) 0 0 / 46px 46px,
      linear-gradient(to bottom, color-mix(in srgb, var(--color-iris-soft) 9%, transparent) 1px, transparent 1px) 0 0 / 46px 46px,
      radial-gradient(closest-side, color-mix(in srgb, var(--color-iris) 30%, transparent), color-mix(in srgb, var(--color-navy) 40%, transparent) 70%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) 22%, transparent);
  }
  .ind-floor span {
    position: absolute;
    right: 18px;
    bottom: 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-iris-soft) 70%, transparent);
  }
  /* The CMDB at the centre: a small gold-rimmed cube. */
  .ind-core {
    --c: 64px;
    position: absolute;
    left: calc(var(--c) / -2);
    top: calc(var(--pw) / 2 - var(--c));
    width: var(--c);
    height: var(--c);
    transform: rotateY(calc(var(--p) * 300deg - 18deg));
  }
  .ind-core > i,
  .ind-core > b {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 1.5px solid color-mix(in srgb, var(--color-gold) 80%, transparent);
    background: color-mix(in srgb, var(--color-gold) 10%, color-mix(in srgb, var(--color-night) 70%, transparent));
    box-shadow: 0 0 30px color-mix(in srgb, var(--color-gold) 30%, transparent);
  }
  .ind-core > i:nth-child(1) {
    transform: rotateY(90deg) translateZ(calc(var(--c) / 2));
  }
  .ind-core > i:nth-child(2) {
    transform: rotateY(-90deg) translateZ(calc(var(--c) / 2));
  }
  .ind-core > i:nth-child(3) {
    transform: rotateX(90deg) translateZ(calc(var(--c) / 2));
  }
  .ind-core > b {
    transform: translateZ(calc(var(--c) / 2));
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--color-gold-glow);
  }
  /* A sector panel, standing on the ring. Brighter as it turns to the front. */
  .ind-panel {
    --face: cos(calc(var(--a) - var(--p) * 300deg + 18deg));
    position: absolute;
    left: calc(var(--pw) / -2);
    top: calc(var(--pw) / -2);
    width: var(--pw);
    height: var(--pw);
    transform: rotateY(var(--a)) translateZ(var(--r));
  }
  .ind-front,
  .ind-back {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: 6px;
  }
  .ind-front {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: calc(var(--pw) * 0.09);
    background:
      radial-gradient(80% 70% at 30% 0%, color-mix(in srgb, var(--color-iris) calc(max(var(--face), 0) * 40%), transparent), transparent 75%),
      linear-gradient(150deg, color-mix(in srgb, var(--color-white) 14%, transparent), color-mix(in srgb, var(--color-white) 3%, transparent) 60%),
      color-mix(in srgb, var(--color-navy) 75%, var(--color-night));
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) calc(25% + max(var(--face), 0) * 55%), transparent),
      0 0 calc(max(var(--face), 0) * 40px) color-mix(in srgb, var(--color-iris) 45%, transparent);
    opacity: calc(0.35 + max(var(--face), 0) * 0.65);
  }
  .ind-front :global(svg) {
    width: calc(var(--pw) * 0.2);
    height: calc(var(--pw) * 0.2);
    margin-bottom: auto;
    color: var(--color-iris-soft);
  }
  .ind-front b {
    font-size: calc(var(--pw) * 0.095);
    line-height: 1.1;
    color: var(--color-white);
  }
  .ind-front span {
    font-size: calc(var(--pw) * 0.072);
    line-height: 1.3;
    color: var(--color-grey-200);
  }
  .ind-back {
    transform: rotateY(180deg);
    background: color-mix(in srgb, var(--color-indigo) 50%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) 18%, transparent);
  }

  /* ── The list ── */
  .ind-chips {
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 560px) and (max-width: 1023px) {
    .ind-chips {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .ind-chips li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .ind-chips b {
    display: block;
    font-size: 1.08rem;
    color: var(--color-white);
  }
  .ind-line {
    display: block;
    font-size: 0.95rem;
    color: var(--color-grey-400);
  }
</style>
