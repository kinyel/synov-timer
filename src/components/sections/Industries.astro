---
/**
 * 07 · Industries. A photo-led opening, then the six sectors from Raleston's
 * site, each with ServiceNow use cases specific to it.
 */
import { Image } from 'astro:assets';
import teamPhoto from '../../assets/images/team-glass-icons.png';
import { INDUSTRIES } from '../../data/industries';
import Icon from '../ui/Icon.astro';
---

<section id="industries" class="section industries" data-scene="industries" data-theme="dark" aria-labelledby="industries-title">
  <div class="gutter">
    <div class="ind-head">
      <div>
        <p class="eyebrow">Industries</p>
        <h2 id="industries-title" class="h2 mt-4" data-reveal>Six sectors, <span class="text-lit">one platform</span></h2>
      </div>
      <p class="lead max-w-[36rem]" data-reveal>
        The platform is the same everywhere; what changes is what each sector needs from it. Here is how ServiceNow is used in the industries we serve, and what we can build for each. Our founder has delivered ServiceNow work in healthcare, retail, enterprise and government.
      </p>
    </div>

    <figure class="ind-photo" data-reveal>
      <div class="ind-photo-mask">
        <Image
          src={teamPhoto}
          alt="Two colleagues working at a table with laptops, with glass icons floating beside them to suggest connected systems."
          widths={[640, 960, 1440, 1920, 2560]}
          sizes="(min-width: 1440px) 1300px, 92vw"
          loading="lazy"
          class="ind-img"
          data-parallax="0.12"
        />
      </div>
      <figcaption class="ind-chip card">
        <span class="icon-tile is-data"><Icon name="cmdb" /></span>
        <span><b>One data model</b> across every sector: services, assets and requests on the same CMDB.</span>
      </figcaption>
    </figure>

    <ul class="ind-grid">
      {
        INDUSTRIES.map((ind) => (
          <li class="card ind-card" data-reveal>
            <div class="flex items-center gap-3">
              <span class="icon-tile">
                <Icon name={ind.icon} />
              </span>
              <h3 class="h3">{ind.name}</h3>
            </div>
            <p class="body mt-4">{ind.summary}</p>
            <ul class="ind-uses">
              {ind.uses.map((u) => (
                <li>
                  <b>{u.title}</b>
                  <span>{u.text}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .industries {
    background:
      radial-gradient(45% 40% at 10% 20%, color-mix(in srgb, var(--color-violet) 14%, transparent), transparent 70%),
      radial-gradient(40% 40% at 95% 60%, color-mix(in srgb, var(--color-azure) 10%, transparent), transparent 70%),
      var(--color-night);
  }
  .ind-head {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }
  @media (min-width: 1024px) {
    .ind-head {
      grid-template-columns: 1fr 1.1fr;
      gap: 4rem;
    }
  }
  .ind-photo {
    position: relative;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
  }
  .ind-photo-mask {
    position: relative;
    height: clamp(16rem, 38vw, 30rem);
    overflow: hidden;
    border-radius: 2rem;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-white) 10%, transparent);
  }
  .ind-photo-mask::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--color-night) 65%, transparent), transparent 55%),
      linear-gradient(0deg, color-mix(in srgb, var(--color-indigo) 55%, transparent), transparent 50%);
    mix-blend-mode: multiply;
    pointer-events: none;
  }
  :global(.ind-img) {
    display: block;
    width: 100%;
    height: 125%;
    margin-top: -6%;
    object-fit: cover;
  }
  .ind-chip {
    position: absolute;
    left: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    display: flex;
    gap: 0.9rem;
    align-items: center;
    max-width: 24rem;
    padding: 1rem 1.15rem;
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--color-grey-200);
    background: color-mix(in srgb, var(--color-night) 90%, transparent);
    backdrop-filter: blur(12px);
  }
  .ind-chip b {
    color: var(--color-white);
  }
  .ind-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 720px) {
    .ind-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .ind-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ind-card {
    padding: 1.6rem;
  }
  .ind-uses {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--color-white) 8%, transparent);
  }
  .ind-uses li {
    display: grid;
    gap: 0.15rem;
    font-size: 0.94rem;
    line-height: 1.45;
    color: var(--color-grey-200);
  }
  .ind-uses b {
    color: var(--color-white);
  }
</style>
