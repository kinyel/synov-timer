---
/**
 * 06 · Case study highlights. Real case studies only: until Raleston has
 * approved ones, production shows a 3D stack of three case files, still
 * sealed, and an offer of references. Draft samples show in development and
 * previews, as short cards.
 */
import { getCollection } from 'astro:content';
import { visible, SHOW_DRAFTS } from '../../lib/drafts';
import Icon from '../ui/Icon.astro';
import { blk } from '../../lib/iso';

const cases = (await getCollection('caseStudies')).filter(visible).slice(0, 3);
---

<section id="cases" class="section cases" data-scene="cases" data-theme="dark" aria-labelledby="cases-title">
  <div class="gutter">
    {
      cases.length > 0 ? (
        <>
          <div class="flex flex-wrap items-end justify-between gap-6">
            <div>
              <p class="eyebrow">Case studies</p>
              <h2 id="cases-title" class="h2 mt-4" data-reveal>
                Work we can <span class="text-lit">show you</span>
              </h2>
            </div>
            <a href="/case-studies/" class="link-arrow" data-reveal>
              All case studies <Icon name="arrow" />
            </a>
          </div>
          <ul class="cases-grid">
            {cases.map((c) => (
              <li data-reveal>
                <a href={`/case-studies/${c.id}/`} class="card card-hover case-card">
                  {c.data.draft && <span class="draft-tag">Draft sample</span>}
                  <p class="case-industry">{c.data.industry}</p>
                  <h3 class="h3 mt-3">{c.data.title}</h3>
                  <span class="link-arrow mt-auto pt-4">
                    Read it <Icon name="arrow" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {SHOW_DRAFTS && cases.some((c) => c.data.draft) && <p class="draft-note">Draft samples show in development and previews only.</p>}
        </>
      ) : (
        <div class="cases-soon">
          <div class="s3d cases-scene" data-s3d aria-hidden="true">
            <div class="s3d-world">
              <span class="cases-pool" />
              {[0, 1, 2].map((i) => (
                <div class={`blk case-file ${i === 2 ? 'is-lit' : ''}`} style={blk(0, 0, 210, 6, 0, `--i:${i}`)}>
                  <b class="blk-top">
                    <span class="case-ghost">
                      <i class="w-[46%]" />
                      <i class="w-[70%]" />
                      <i class="w-[58%]" />
                      <i class="case-seal" />
                    </span>
                  </b>
                  <b class="blk-e" />
                  <b class="blk-s" />
                </div>
              ))}
            </div>
          </div>
          <div class="cases-copy">
            <p class="eyebrow">Case studies</p>
            <h2 id="cases-title" class="h2 mt-4" data-reveal>
              Work we can <span class="text-lit">show you</span>
            </h2>
            <p class="lead mt-4" data-reveal>
              Detailed case studies are on the way. Until then, ask for references.
            </p>
            <a href="/contact/?topic=references" class="btn btn-primary mt-7" data-magnetic data-reveal>
              Ask for references <Icon name="arrowUpRight" />
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .cases {
    overflow: hidden;
    background:
      radial-gradient(40% 50% at 30% 40%, color-mix(in srgb, var(--color-iris) 16%, transparent), transparent 70%),
      var(--color-night);
  }
  .cases-grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 900px) {
    .cases-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cases-grid > li {
    display: flex;
  }
  .case-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    padding: 1.6rem;
  }
  .case-industry {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .draft-tag {
    align-self: flex-start;
    margin-bottom: 0.8rem;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
    background: var(--color-gold);
  }
  .draft-note {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--color-grey-400);
  }

  /* ── Coming soon: three sealed case files ── */
  .cases-soon {
    display: grid;
    gap: 1rem;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .cases-soon {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
    }
  }
  .cases-scene {
    --k: 0.7;
    height: 330px;
    order: 2;
  }
  @media (min-width: 1024px) {
    .cases-scene {
      --k: 1;
      height: 470px;
      order: 0;
    }
  }
  .cases-scene .s3d-world {
    top: 62%;
  }
  .cases-pool {
    position: absolute;
    left: -260px;
    top: -260px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--color-iris) 26%, transparent), transparent);
    transform: translateZ(-20px);
  }
  /* The files open up as the section arrives, then float. */
  .case-file {
    --dz: calc(var(--i) * (24px + var(--p) * 60px));
    animation: case-bob 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -2s);
  }
  @keyframes case-bob {
    50% {
      translate: 0 0 10px;
    }
  }
  .case-ghost {
    position: absolute;
    inset: 14% 12%;
    display: grid;
    align-content: start;
    gap: 9%;
  }
  .case-ghost i {
    display: block;
    height: 9px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--color-white) 14%, transparent);
  }
  .case-ghost .case-seal {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: none;
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--color-iris-soft) 50%, transparent);
  }
  .case-file.is-lit .case-seal {
    box-shadow:
      inset 0 0 0 1.5px var(--color-gold),
      0 0 18px color-mix(in srgb, var(--color-gold) 60%, transparent);
  }
</style>
