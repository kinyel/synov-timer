---
/**
 * 06 · Case study highlights. Real case studies only: until Raleston has
 * approved ones, production shows the layout with a "coming soon" note and an
 * offer of references. Draft samples show in development and previews.
 */
import { getCollection } from 'astro:content';
import { visible, SHOW_DRAFTS } from '../../lib/drafts';
import Icon from '../ui/Icon.astro';

const cases = (await getCollection('caseStudies')).filter(visible).slice(0, 3);
const ghost = [
  { industry: 'Industry', title: 'Client type and challenge', modules: ['Module', 'Module'] },
  { industry: 'Industry', title: 'Client type and challenge', modules: ['Module', 'Module'] },
  { industry: 'Industry', title: 'Client type and challenge', modules: ['Module', 'Module'] },
];
---

<section id="cases" class="section cases" data-scene="cases" data-theme="dark" aria-labelledby="cases-title">
  <div class="gutter">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Case studies</p>
        <h2 id="cases-title" class="h2 mt-4" data-reveal>Work we can <span class="text-lit">show you</span></h2>
      </div>
      <a href="/case-studies/" class="link-arrow" data-reveal>All case studies <Icon name="arrow" /></a>
    </div>

    {
      cases.length > 0 ? (
        <ul class="cases-grid">
          {cases.map((c) => (
            <li data-reveal>
              <a href={`/case-studies/${c.id}/`} class="card card-hover case-card">
                {c.data.draft && <span class="draft-tag">Draft sample</span>}
                <p class="case-industry">{c.data.industry}</p>
                <h3 class="h3 mt-3">{c.data.title}</h3>
                <p class="body mt-3">{c.data.summary}</p>
                <ul class="case-mods">
                  {c.data.modules.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
                <span class="link-arrow mt-auto pt-4">
                  Read the case study <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="cases-soon" data-reveal>
          <ul class="cases-grid cases-ghost" aria-hidden="true">
            {ghost.map((g) => (
              <li class="card case-card">
                <p class="case-industry">{g.industry}</p>
                <p class="ghost-line w-[80%]" />
                <p class="ghost-line w-[60%]" />
                <p class="ghost-text" />
                <p class="ghost-text w-[85%]" />
                <ul class="case-mods">
                  {g.modules.map((m) => (
                    <li>{m}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
          <div class="soon-note card">
            <span class="icon-tile">
              <Icon name="book" />
            </span>
            <div>
              <p class="h3">Detailed case studies coming soon.</p>
              <p class="body mt-2">Ask us for references: we will put you in touch with clients who can tell you what it is like to work with us.</p>
              <a href="/contact/?topic=references" class="btn btn-primary mt-5" data-magnetic>
                Ask for references <Icon name="arrowUpRight" />
              </a>
            </div>
          </div>
        </div>
      )
    }
    {SHOW_DRAFTS && cases.some((c) => c.data.draft) && <p class="draft-note">Draft samples are shown in development and preview builds only. Production shows the “coming soon” state until real, client-approved case studies are added.</p>}
  </div>
</section>

<style>
  .cases {
    background:
      radial-gradient(40% 50% at 50% 0%, color-mix(in srgb, var(--color-iris) 14%, transparent), transparent 70%),
      var(--color-night);
  }
  .cases-grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  @media (min-width: 900px) {
    .cases-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cases-grid > li {
    display: flex;
  }
  .case-card {
    display: flex;
    width: 100%;
    flex-direction: column;
    padding: 1.6rem;
  }
  .case-industry {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .case-mods {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }
  .case-mods li {
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    font-size: 0.82rem;
    color: var(--color-grey-200);
    background: color-mix(in srgb, var(--color-white) 7%, transparent);
  }
  .draft-tag {
    align-self: flex-start;
    margin-bottom: 0.8rem;
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-navy);
    background: var(--color-gold);
  }
  .draft-note {
    margin-top: 1.25rem;
    font-size: 0.9rem;
    color: var(--color-grey-400);
  }
  .cases-soon {
    position: relative;
  }
  .cases-ghost {
    filter: blur(1.5px);
    opacity: 0.45;
  }
  .ghost-line,
  .ghost-text {
    height: 0.9rem;
    margin-top: 0.8rem;
    border-radius: 0.4rem;
    background: color-mix(in srgb, var(--color-white) 14%, transparent);
  }
  .ghost-text {
    height: 0.6rem;
    background: color-mix(in srgb, var(--color-white) 8%, transparent);
  }
  .soon-note {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    gap: 1.1rem;
    width: min(92%, 34rem);
    padding: 1.6rem;
    transform: translate(-50%, -40%);
    background: color-mix(in srgb, var(--color-night) 94%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) 35%, transparent),
      0 40px 80px -30px rgb(0 0 0 / 0.9);
  }
  @media (max-width: 899px) {
    .soon-note {
      position: relative;
      left: auto;
      top: auto;
      width: 100%;
      margin-top: -6rem;
      transform: none;
    }
  }
</style>
