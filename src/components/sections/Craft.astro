---
/**
 * 02 · Craft (pinned). The camera orbits HQ low against the sky; two kinetic
 * lines slide in opposite directions *behind* it (z 0, under the canvas) and
 * skew with scroll speed. The value-prop cards swap with clip-path reveals.
 */
const props = [
  {
    title: 'Architect-led excellence',
    line: 'Master craftsmen, not just configurators.',
    detail: 'A certified architect leads every engagement and designs the solution before anything is configured.',
  },
  {
    title: 'Lightning results',
    line: 'Value in weeks, not months.',
    detail: 'Work ships in short, usable increments, so you see results early and can steer as you go.',
  },
  {
    title: 'Empire building',
    line: 'Platforms that scale with your ambitions.',
    detail: 'Clean data models and shared standards make each new module easier to add than the last.',
  },
];
---

<section id="craft" data-scene="craft" data-theme="light" data-webgl="campus" class="relative h-[340svh]">
  <div class="layer-bg absolute inset-0" style="background: linear-gradient(180deg, #f6f8fb 0%, #eceff4 100%);" aria-hidden="true"></div>
  <div class="layer-bg sticky top-0 flex h-svh flex-col justify-center gap-[1.5vw] overflow-hidden pb-[12svh] max-md:justify-start max-md:pt-[22svh]" aria-hidden="true">
    <p class="display whitespace-nowrap text-[10vw] leading-none text-ink/[0.07] max-md:text-[15vw]" data-craft-a>MASTER CRAFTSMEN</p>
    <p class="display whitespace-nowrap text-[6.4vw] leading-none text-transparent [-webkit-text-stroke:1.5px_rgb(242_178_0/0.75)] max-md:text-[9.5vw]" data-craft-b>
      NOT JUST CONFIGURATORS
    </p>
  </div>
  <div class="layer-copy gutter pointer-events-none sticky top-0 -mt-[100svh] flex h-svh items-end pb-[max(1rem,env(safe-area-inset-bottom))] md:pb-10">
    <div class="story-stack pointer-events-auto">
      {
        props.map((p, i) => (
          <article class="story-card" data-craft-card={i} style={i ? 'clip-path: inset(100% 0 0 0 round 1.4rem)' : 'clip-path: inset(0 0 0 0 round 1.4rem)'}>
            <p class="story-eyebrow">
              <span>{p.title}</span>
              <span class="num">0{i + 1} / 03</span>
            </p>
            <div>
              <h3 class="story-title">{p.line}</h3>
              <p class="story-body">{p.detail}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
