---
/**
 * 01 · Hero. The campus model lives in the canvas (z 10). This section
 * supplies the light studio background under it (z 0) and a compact copy
 * card above it (z 20), bottom-left like the reference: the model is the star.
 */
---

<section id="hero" data-scene="hero" data-theme="light" data-webgl="campus" class="relative min-h-svh">
  <div class="layer-bg absolute inset-0 overflow-hidden" style="background: linear-gradient(180deg, #f8fafc 0%, #eef1f5 55%, #e9ecf1 100%);" aria-hidden="true">
    <img src="/brand/mark.svg" alt="" class="no-webgl-art absolute top-[18%] right-[10%] w-[30vw] max-w-[26rem] opacity-90" />
  </div>

  <div class="layer-copy gutter flex min-h-svh flex-col justify-end pt-28 pb-[max(1rem,env(safe-area-inset-bottom))] md:pb-[max(2.5rem,env(safe-area-inset-bottom))]">
    <div
      class="w-full max-w-[27rem] rounded-[1.4rem] border border-white/70 bg-white/72 p-5 text-ink shadow-[0_24px_60px_-30px_rgb(10_16_48/0.35)] backdrop-blur-xl md:p-7"
      data-hero-card
    >
      <p class="label text-[0.66rem] text-ink/55" data-hero-kicker>ServiceNow architects · Ottawa</p>
      <h1 class="mt-3 font-display text-[1.9rem] leading-[1.02] font-semibold tracking-[-0.03em] md:text-[2.5rem]" data-hero-title>
        <span class="line-mask" data-line><span class="block">Architecting</span></span>
        <span class="line-mask" data-line><span class="block"><span class="marker">digital empires</span></span></span>
        <span class="line-mask" data-line><span class="block">with ServiceNow.</span></span>
      </h1>
      <p class="mt-4 text-[0.9rem] leading-relaxed text-ink/70" data-hero-intro>
        Certified architects across ITSM, ITOM, IT Asset Management, scoped applications and enterprise architecture.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2" data-hero-ctas>
        <a href="#contact" class="btn btn-gold !px-4 !py-3 text-[0.8rem] md:!px-5 md:text-[0.85rem]" data-magnetic>Start your transformation</a>
        <a href="#services" class="btn !px-4 !py-3 text-[0.8rem] text-ink shadow-[inset_0_0_0_1.5px_rgb(10_16_48/0.25)] hover:bg-ink/5 md:!px-5 md:text-[0.85rem]" data-magnetic>Services</a>
      </div>
    </div>
  </div>
</section>
