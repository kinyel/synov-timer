---
/**
 * 01 · Hero. The campus model lives in the canvas (z 10). This section
 * supplies the light studio background under it (z 0) and the copy card above
 * it (z 20), bottom-left: present enough to read at a glance, with the model
 * still the largest thing on screen.
 */
---

<section id="hero" data-scene="hero" data-theme="light" data-webgl="campus" class="relative min-h-svh">
  <div
    class="layer-bg absolute inset-0 overflow-hidden"
    style="background: radial-gradient(42% 34% at 18% 92%, rgb(242 178 0 / 0.09), transparent 70%), linear-gradient(180deg, #f8fafc 0%, #eef1f5 55%, #e9ecf1 100%);"
    aria-hidden="true"
  >
    <img src="/brand/mark.svg" alt="" class="no-webgl-art absolute top-[18%] right-[10%] w-[30vw] max-w-[26rem] opacity-90" />
  </div>

  <div class="layer-copy gutter flex min-h-svh flex-col justify-end pt-28 pb-[max(1rem,env(safe-area-inset-bottom))] md:pb-[max(3.25rem,env(safe-area-inset-bottom))]">
    <div class="hero-card w-full max-w-[29rem] p-5 text-ink md:max-w-[33rem] md:p-9" data-hero-card>
      <p class="hero-kicker" data-hero-kicker>ServiceNow architects<span class="max-[360px]:hidden"> · Ottawa</span></p>
      <h1 class="hero-title mt-3 md:mt-5" data-hero-title>
        <span class="line-mask" data-line><span class="block">Architecting</span></span>
        <span class="line-mask" data-line><span class="block"><span class="marker">digital empires</span></span></span>
        <span class="line-mask" data-line><span class="block">with ServiceNow.</span></span>
      </h1>
      <p class="mt-4 max-w-[28rem] text-[0.92rem] leading-[1.55] text-ink/80 md:mt-6 md:text-[1.04rem]" data-hero-intro>
        Certified architects for ITSM, ITOM, IT Asset Management, scoped applications and enterprise architecture.{' '}
        <span class="max-md:hidden">Each building on this campus is one of those practices.</span>
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-2 md:mt-7 md:gap-3" data-hero-ctas>
        <a href="#contact" class="btn btn-gold !px-4 !py-3 text-[0.82rem] md:!px-6 md:!py-3.5 md:text-[0.9rem]" data-magnetic>Start your transformation</a>
        <a href="#services" class="btn btn-outline-gold !px-4 !py-3 text-[0.82rem] md:!px-6 md:!py-3.5 md:text-[0.9rem]" data-magnetic>Services</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-card {
    position: relative;
    border-radius: 1.6rem;
    background: rgb(255 255 255 / 0.88);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.9),
      0 34px 80px -34px rgb(10 16 48 / 0.45);
    backdrop-filter: blur(24px) saturate(1.2);
    -webkit-backdrop-filter: blur(24px) saturate(1.2);
  }
  /* A gold hairline across the top edge, matching the story cards. */
  .hero-card::before {
    content: '';
    position: absolute;
    left: 1.6rem;
    right: 1.6rem;
    top: 0;
    height: 2px;
    border-radius: 0 0 2px 2px;
    background: linear-gradient(90deg, #f2b200, rgb(242 178 0 / 0.2) 70%, transparent);
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: #8c6200;
  }
  .hero-kicker::before {
    content: '';
    width: 1.4rem;
    height: 1px;
    background: currentColor;
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
    font-weight: 650;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }
  @media (min-width: 768px) {
    .hero-kicker {
      font-size: 0.72rem;
    }
    .hero-title {
      font-size: clamp(2.7rem, 3.4vw, 3.45rem);
    }
  }
  @media (max-width: 380px) {
    .hero-title {
      font-size: 1.95rem;
    }
  }
</style>
