---
/**
 * TCPWave spotlight. A 3D model of the flow: four square blocks, from the
 * approved change to the DNS and DHCP set-up, and a gold packet that travels
 * across them, lighting each step as it arrives. The facts come from
 * TCPWave's own integration guide; Raleston's part is a placeholder until the
 * client supplies it (development and previews only).
 */
import { SHOW_DRAFTS } from '../../lib/drafts';
import Icon from '../ui/Icon.astro';
import TcpFlow from '../scenes/TcpFlow.astro';
---

<section id="tcpwave" class="section tcp" data-theme="dark" aria-labelledby="tcp-title">
  <div class="gutter">
    <div class="card tcp-card">
      <div>
        <p class="eyebrow">Integration spotlight</p>
        <h2 id="tcp-title" class="h2 tcp-title mt-4" data-reveal>TCPWave and ServiceNow: <span class="text-lit">network changes, automated</span></h2>
        <p class="lead mt-4 max-w-[30rem]" data-reveal>An approved change sets up the IP address, DNS and DHCP by itself.</p>
        {SHOW_DRAFTS && <p class="placeholder">Placeholder: Raleston’s own TCPWave work goes here. Needed from the client.</p>}
        <a href="/solutions/tcpwave/" class="link-arrow mt-5" data-reveal>How it works <Icon name="arrow" /></a>
      </div>

      <TcpFlow />
    </div>
  </div>
</section>

<style>
  .tcp {
    padding-block: clamp(3rem, 6vw, 5rem);
    background: var(--color-night);
  }
  .tcp-card {
    display: grid;
    gap: 1rem;
    overflow: hidden;
    padding: clamp(1.6rem, 4vw, 3rem);
    background:
      radial-gradient(60% 80% at 100% 50%, color-mix(in srgb, var(--color-azure) 16%, transparent), transparent 70%),
      color-mix(in srgb, var(--color-navy) 60%, var(--color-night));
  }
  @media (min-width: 1024px) {
    .tcp-card {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      align-items: center;
      gap: 2rem;
    }
  }
  .tcp-title {
    font-size: clamp(1.8rem, 3.2vw, 2.7rem);
  }
  .placeholder {
    margin-top: 1rem;
    border-radius: 0.8rem;
    padding: 0.7rem 0.9rem;
    font-size: 0.92rem;
    color: var(--color-navy);
    background: var(--color-gold);
  }

</style>
