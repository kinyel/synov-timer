---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { DELIVERY, PLATFORM } from '../../data/services';
import { SITE } from '../../data/site';

/** The first sentence, or the first two when the first is only a lead-in. */
const summary = (t: string) => {
  const [a = '', b = ''] = t.match(/[^.!?]+[.!?]+/g) ?? [t];
  return (a.length < 70 ? `${a}${b}` : a).trim();
};
const schema = [
  {
    '@type': 'ItemList',
    name: 'Raleston Consulting services',
    itemListElement: [...PLATFORM, ...DELIVERY].map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE.url}/services/${s.slug}/`,
      name: s.name,
    })),
  },
];
---

<Base
  title="ServiceNow services: ITSM, ITOM, ITAM, CMDB and more | Raleston"
  description="Every ServiceNow service Raleston offers: ITSM, ITOM, ITAM, CMDB, SPM, integrations, App Engine and architecture, plus advisory, implementation and support."
  crumbs={[{ name: 'Services', href: '/services/' }]}
  schema={schema}
>
  <PageHero
    crumbs={[{ name: 'Services', href: '/services/' }]}
    eyebrow="Services"
    title="ServiceNow services, from roadmap to run"
    lit="roadmap to run"
    lead="Certified architects for every part of the platform you run, and four ways to work with us, from a first health check to support long after go-live."
  />

  <section class="section pt-6" data-theme="dark" aria-labelledby="platform-title">
    <div class="gutter">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="platform-title" class="h2">The platform</h2>
        <p class="lead max-w-[30rem]">What we design, build and connect. Each page explains it in plain English, then in technical depth.</p>
      </div>
      <ul class="grid-cards">
        {
          PLATFORM.map((s) => (
            <li data-reveal>
              <a href={`/services/${s.slug}/`} class="card card-hover tile">
                <span class={`icon-tile ${s.accent === 'data' ? 'is-data' : ''}`}>
                  <Icon name={s.icon} />
                </span>
                <h3 class="h3 mt-5">{s.short === s.name ? s.name : s.short}</h3>
                {s.short !== s.name && <p class="tile-full">{s.name}</p>}
                <p class="body mt-3">{summary(s.plain)}</p>
                <span class="link-arrow mt-auto pt-4">
                  Explore <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section deliver" data-theme="dark" aria-labelledby="deliver-title">
    <div class="gutter">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="deliver-title" class="h2">How we deliver</h2>
        <p class="lead max-w-[30rem]">Four stages, one team. Join at whichever stage you are at.</p>
      </div>
      <ol class="grid-deliver">
        {
          DELIVERY.map((s, i) => (
            <li data-reveal>
              <a href={`/services/${s.slug}/`} class="card card-hover tile">
                <span class="tile-n">Stage {String(i + 1).padStart(2, '0')}</span>
                <h3 class="h3 mt-3">{s.name}</h3>
                <p class="body mt-3">{s.lead}</p>
                <p class="tile-meta">
                  <Icon name="clock" /> {s.duration}
                </p>
                <span class="link-arrow mt-auto pt-4">
                  How it runs <Icon name="arrow" />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section pt-0" data-theme="dark" aria-labelledby="start-title">
    <div class="gutter">
      <div class="card start" data-reveal>
        <span class="icon-tile is-ai"><Icon name="ai" /></span>
        <div>
          <h2 id="start-title" class="h3">Not sure where to start?</h2>
          <p class="body mt-2 max-w-[44rem]">
            Most clients begin with <a href="/services/advisory-and-strategy/" class="text-iris-soft underline underline-offset-4">advisory and strategy</a>: a short health check of the platform you already own, and a roadmap in stages. AI readiness is part of it, so you know where ServiceNow Otto, custom skills and MCP will help.
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid-cards {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .grid-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid-cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .grid-cards li,
  .grid-deliver li {
    display: flex;
  }
  .tile {
    display: flex;
    width: 100%;
    flex-direction: column;
    padding: 1.5rem;
  }
  .tile-full {
    margin-top: 0.3rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-grey-400);
  }
  .deliver {
    background:
      radial-gradient(50% 50% at 50% 40%, color-mix(in srgb, var(--color-violet) 14%, transparent), transparent 70%),
      var(--color-night);
  }
  .grid-deliver {
    display: grid;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 720px) {
    .grid-deliver {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid-deliver {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tile-n {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .tile-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1rem;
    font-size: 0.92rem;
    color: var(--color-white);
  }
  .tile-meta :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--color-iris-soft);
  }
  .start {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: clamp(1.4rem, 3vw, 2rem);
  }
</style>
