---
/**
 * One page per service (src/data/services.ts), kept short: a two-sentence
 * summary, what you get, how it fits together (a diagram), how AI helps, then
 * the full detail folded away (everything we deliver, the technical notes and
 * FAQs) for those who want it, and related services.
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Diagram from '../../components/diagrams/Diagram.astro';
import Faq from '../../components/ui/Faq.astro';
import Icon from '../../components/ui/Icon.astro';
import { SERVICES, serviceBySlug, type Service } from '../../data/services';
import { SITE } from '../../data/site';
import { faqSchema } from '../../lib/schema';

export const getStaticPaths = (() => SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }))) satisfies GetStaticPaths;

const { s } = Astro.props as { s: Service };
const related = s.related.map((r) => serviceBySlug(r)!).filter(Boolean);
const words = s.headline.split(' ');
const lit = words.slice(-2).join(' ');
/** The first sentence, or the first n sentences. */
const sentences = (t: string, n = 1) => (t.match(/[^.!?]+[.!?]+/g) ?? [t]).slice(0, n).join('').trim();
const schema = [
  {
    '@type': 'Service',
    '@id': `${SITE.url}/services/${s.slug}/#service`,
    name: s.name === s.short ? s.name : `${s.name} (${s.short})`,
    serviceType: s.name,
    description: s.seo.description,
    url: `${SITE.url}/services/${s.slug}/`,
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: { '@type': 'Country', name: SITE.countryName },
  },
  faqSchema(s.faqs),
];
---

<Base title={s.seo.title} description={s.seo.description} crumbs={[{ name: 'Services', href: '/services/' }, { name: s.short === s.name ? s.name : s.short, href: `/services/${s.slug}/` }]} schema={schema}>
  <PageHero
    crumbs={[
      { name: 'Services', href: '/services/' },
      { name: s.short === s.name ? s.name : s.short, href: `/services/${s.slug}/` },
    ]}
    eyebrow={s.kind === 'platform' ? 'Platform' : 'How we deliver'}
    title={s.headline}
    lit={lit}
    lead={sentences(s.lead)}
    icon={s.icon}
  >
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={`/contact/?topic=${s.slug}`} class="btn btn-primary" data-magnetic>Talk to an architect <Icon name="arrowUpRight" /></a>
      <a href="#how" class="btn btn-outline">See how it works</a>
    </div>
  </PageHero>

  <article class="svc" data-theme="dark">
    <section class="svc-row gutter" aria-labelledby="plain">
      <h2 id="plain" class="svc-label">In short</h2>
      <p class="svc-plain" data-reveal>{sentences(s.plain, 2)}</p>
    </section>

    <section class="svc-row gutter" aria-labelledby="get">
      <h2 id="get" class="svc-label">What you get</h2>
      <div>
        <ul class="svc-outcomes">
          {
            s.outcomes.map((o) => (
              <li data-reveal>
                <Icon name="check" />
                <span>{o}</span>
              </li>
            ))
          }
        </ul>
        {
          s.steps && (
            <ol class="svc-steps" data-reveal>
              {s.steps.map((st, i) => (
                <li>
                  <span>{String(i + 1).padStart(2, '0')}</span> {st.name}
                </li>
              ))}
            </ol>
          )
        }
        {
          s.duration && (
            <p class="svc-duration" data-reveal>
              <Icon name="clock" /> {s.duration}
            </p>
          )
        }
      </div>
    </section>

    <section id="how" class="svc-row gutter" aria-labelledby="how-title">
      <h2 id="how-title" class="svc-label">How it fits together</h2>
      <div data-reveal>
        <Diagram diagram={s.diagram} title={`Diagram: ${s.diagram.caption}`} />
      </div>
    </section>

    <section class="svc-row gutter" aria-labelledby="ai">
      <h2 id="ai" class="svc-label svc-label-ai"><span class="badge badge-ai">AI</span> How AI helps</h2>
      <ul class="dots svc-ai-list" data-reveal>
        {s.ai.points.map((p) => <li>{p}</li>)}
      </ul>
    </section>

    <section class="svc-row gutter" aria-labelledby="more">
      <h2 id="more" class="svc-label">The detail</h2>
      <div class="svc-more">
        <details class="card svc-tech">
          <summary>
            <span>Everything we deliver</span>
            <Icon name="plus" />
          </summary>
          <ul>
            {s.delivers.map((d) => <li>{d}</li>)}
          </ul>
          {
            s.who && (
              <p class="svc-who">
                <b>From Raleston:</b> {s.who.raleston}. <b>From your side:</b> {s.who.you}.
              </p>
            )
          }
        </details>
        <details class="card svc-tech">
          <summary>
            <span>For technical teams</span>
            <Icon name="plus" />
          </summary>
          <ul>
            {s.technical.map((t) => <li>{t}</li>)}
          </ul>
        </details>
        <h3 class="svc-faq-h">Questions</h3>
        <Faq items={s.faqs} />
      </div>
    </section>

    <section class="svc-row gutter" aria-labelledby="related">
      <h2 id="related" class="svc-label">Related services</h2>
      <ul class="svc-related">
        {
          related.map((r) => (
            <li data-reveal>
              <a href={`/services/${r.slug}/`} class="card card-hover svc-rel">
                <span class={`icon-tile ${r.accent === 'data' ? 'is-data' : ''}`}>
                  <Icon name={r.icon} />
                </span>
                <span>
                  <b>{r.short === r.name ? r.name : `${r.short}: ${r.name}`}</b>
                  <span>{r.blurb}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Base>

<style>
  .svc {
    padding-bottom: clamp(3rem, 6vw, 5rem);
    color: var(--color-white);
    background: var(--color-night);
  }
  .svc-row {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
    border-top: 1px solid color-mix(in srgb, var(--color-white) 7%, transparent);
  }
  .svc-row:first-child {
    border-top: none;
  }
  @media (min-width: 1024px) {
    .svc-row {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 3rem;
    }
    .svc-label {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
  .svc-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .svc-label-ai {
    color: var(--color-violet-soft);
  }
  .svc-plain {
    max-width: 48rem;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.5;
    color: var(--color-white);
  }
  .svc-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .svc-steps li {
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
    font-size: 0.95rem;
    color: var(--color-white);
    background: color-mix(in srgb, var(--color-white) 7%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-iris-soft) 22%, transparent);
  }
  .svc-steps span {
    margin-right: 0.3rem;
    font-size: 0.8rem;
    font-weight: 800;
    color: var(--color-iris-soft);
  }
  .svc-duration {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    font-size: 1rem;
    color: var(--color-grey-200);
  }
  .svc-duration :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--color-iris-soft);
  }
  .svc-more {
    display: grid;
    gap: 0.75rem;
    max-width: 52rem;
  }
  .svc-who {
    margin: 0 1.4rem 1.3rem;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--color-grey-200);
  }
  .svc-who b {
    color: var(--color-white);
  }
  .svc-faq-h {
    margin-top: 1.25rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .svc-ai-list {
    margin-top: 1.1rem;
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--color-grey-200);
  }
  .svc-ai-list :global(li::before) {
    background: var(--color-violet-soft);
  }
  .svc-outcomes {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 720px) {
    .svc-outcomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .svc-outcomes li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--color-white);
  }
  .svc-outcomes :global(svg) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.1rem;
    color: var(--color-iris-soft);
  }
  .svc-tech summary {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
  }
  .svc-tech summary::-webkit-details-marker {
    display: none;
  }
  .svc-tech summary :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--color-iris-soft);
    transition: transform 0.4s var(--ease-expo);
  }
  .svc-tech[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  .svc-tech ul {
    display: grid;
    gap: 0.65rem;
    padding: 0 1.25rem 1.3rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-grey-200);
  }
  .svc-tech li {
    padding-left: 1rem;
    border-left: 2px solid color-mix(in srgb, var(--color-azure) 60%, transparent);
  }
  .svc-related {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 900px) {
    .svc-related {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .svc-related li {
    display: flex;
  }
  .svc-rel {
    display: flex;
    width: 100%;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.15rem;
  }
  .svc-rel b {
    display: block;
    color: var(--color-white);
  }
  .svc-rel span span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.95rem;
    color: var(--color-grey-200);
  }
</style>
