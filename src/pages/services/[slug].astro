---
/**
 * One page per service (src/data/services.ts), in the same structure:
 * in plain English, why it matters, what we deliver (and, for delivery
 * services, how it runs), a diagram, how AI helps, what you get, the
 * technical detail, FAQs, related services and the closing call to action.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Diagram from '../../components/diagrams/Diagram.astro';
import Faq from '../../components/ui/Faq.astro';
import Icon from '../../components/ui/Icon.astro';
import { SERVICES, serviceBySlug, type Service } from '../../data/services';
import { SITE } from '../../data/site';
import { faqSchema } from '../../lib/schema';
import manDesk from '../../assets/images/man-desk.png';
import teamDc from '../../assets/images/team-datacentre.png';
import engineers from '../../assets/images/engineers-racks.png';
import womanDesk from '../../assets/images/woman-desk.png';
import teamGlass from '../../assets/images/team-glass-icons.png';

export const getStaticPaths = (() => SERVICES.map((s) => ({ params: { slug: s.slug }, props: { s } }))) satisfies GetStaticPaths;

const { s } = Astro.props as { s: Service };
const related = s.related.map((r) => serviceBySlug(r)!).filter(Boolean);
const words = s.headline.split(' ');
const lit = words.slice(-2).join(' ');
const photos: Record<string, { src: ImageMetadata; alt: string }> = {
  itsm: { src: manDesk, alt: 'A service desk analyst with a headset helping a colleague from his desk.' },
  itom: { src: teamDc, alt: 'An IT operations team standing together in a data centre aisle.' },
  itam: { src: engineers, alt: 'Two engineers reviewing equipment models on a large screen, one with a laptop and one with a tablet.' },
  'support-and-optimization': { src: womanDesk, alt: 'A platform owner at her desk checking service dashboards on two monitors.' },
  integrations: { src: teamGlass, alt: 'Two colleagues at a table with laptops, with glass icons floating beside them to suggest connected systems.' },
};
const photo = photos[s.slug];
const schema = [
  {
    '@type': 'Service',
    '@id': `${SITE.url}/services/${s.slug}/#service`,
    name: s.name === s.short ? s.name : `${s.name} (${s.short})`,
    serviceType: s.name,
    description: s.seo.description,
    url: `${SITE.url}/services/${s.slug}/`,
    provider: { '@id': `${SITE.url}/#organization` },
    areaServed: { '@type': 'Country', name: SITE.countryName },
  },
  faqSchema(s.faqs),
];
---

<Base title={s.seo.title} description={s.seo.description} crumbs={[{ name: 'Services', href: '/services/' }, { name: s.short === s.name ? s.name : s.short, href: `/services/${s.slug}/` }]} schema={schema}>
  <PageHero
    crumbs={[
      { name: 'Services', href: '/services/' },
      { name: s.short === s.name ? s.name : s.short, href: `/services/${s.slug}/` },
    ]}
    eyebrow={s.kind === 'platform' ? `Platform · ${s.short === s.name ? s.name : s.name}` : 'How we deliver'}
    title={s.headline}
    lit={lit}
    lead={s.lead}
  >
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={`/contact/?topic=${s.slug}`} class="btn btn-primary" data-magnetic>Talk to an architect <Icon name="arrowUpRight" /></a>
      <a href="#how" class="btn btn-outline">See how it works</a>
    </div>
  </PageHero>

  <article class="svc" data-theme="dark">
    <!-- In plain English -->
    <section class="svc-row gutter" aria-labelledby="plain">
      <h2 id="plain" class="svc-label">In plain English</h2>
      <div>
        <p class="svc-plain" data-reveal>{s.plain}</p>
        {
          photo && (
            <figure class="svc-photo" data-reveal>
              <Image src={photo.src} alt={photo.alt} widths={[480, 800, 1200]} sizes="(min-width: 1024px) 60vw, 92vw" loading="lazy" class="svc-img" data-parallax="0.06" />
            </figure>
          )
        }
      </div>
    </section>

    <!-- Why it matters -->
    <section class="svc-row gutter" aria-labelledby="why">
      <h2 id="why" class="svc-label">Why it matters</h2>
      <ul class="svc-pains">
        {
          s.why.map((w) => (
            <li class="card" data-reveal>
              {w}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- What we deliver / how it runs -->
    <section class="svc-row gutter" aria-labelledby="deliver">
      <h2 id="deliver" class="svc-label">What Raleston delivers</h2>
      <div>
        {
          s.steps && (
            <ol class="svc-steps">
              {s.steps.map((st, i) => (
                <li class="card" data-reveal>
                  <span class="svc-step-n">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class="h3">{st.name}</h3>
                  <p class="body mt-2">{st.text}</p>
                </li>
              ))}
            </ol>
          )
        }
        <ul class="ticks svc-delivers" data-reveal>
          {s.delivers.map((d) => <li>{d}</li>)}
        </ul>
        {
          s.duration && s.who && (
            <dl class="svc-facts" data-reveal>
              <div class="card">
                <dt>
                  <Icon name="clock" /> Typical length
                </dt>
                <dd>{s.duration}</dd>
              </div>
              <div class="card">
                <dt>
                  <Icon name="people" /> From Raleston
                </dt>
                <dd>{s.who.raleston}</dd>
              </div>
              <div class="card">
                <dt>
                  <Icon name="people" /> From your side
                </dt>
                <dd>{s.who.you}</dd>
              </div>
            </dl>
          )
        }
      </div>
    </section>

    <!-- Diagram -->
    <section id="how" class="svc-row gutter" aria-labelledby="how-title">
      <h2 id="how-title" class="svc-label">How it fits together</h2>
      <div data-reveal>
        <Diagram diagram={s.diagram} title={`Diagram: ${s.diagram.caption}`} />
      </div>
    </section>

    <!-- How AI helps -->
    <section class="svc-row gutter" aria-labelledby="ai">
      <h2 id="ai" class="svc-label svc-label-ai"><span class="badge badge-ai">AI</span> How AI helps</h2>
      <div class="card svc-ai" data-reveal>
        <p class="lead">{s.ai.text}</p>
        <ul class="dots svc-ai-list">
          {s.ai.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </section>

    <!-- What you get -->
    <section class="svc-row gutter" aria-labelledby="get">
      <h2 id="get" class="svc-label">What you get</h2>
      <ul class="svc-outcomes">
        {
          s.outcomes.map((o) => (
            <li data-reveal>
              <Icon name="check" />
              <span>{o}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- For technical teams -->
    <section class="svc-row gutter" aria-labelledby="tech">
      <h2 id="tech" class="svc-label">For technical teams</h2>
      <details class="card svc-tech" data-reveal>
        <summary>
          <span>The modules, data model and design decisions</span>
          <Icon name="plus" />
        </summary>
        <ul>
          {s.technical.map((t) => <li>{t}</li>)}
        </ul>
      </details>
    </section>

    <!-- FAQs -->
    <section class="svc-row gutter" aria-labelledby="faqs">
      <h2 id="faqs" class="svc-label">Questions</h2>
      <Faq items={s.faqs} />
    </section>

    <!-- Related -->
    <section class="svc-row gutter" aria-labelledby="related">
      <h2 id="related" class="svc-label">Related services</h2>
      <ul class="svc-related">
        {
          related.map((r) => (
            <li data-reveal>
              <a href={`/services/${r.slug}/`} class="card card-hover svc-rel">
                <span class={`icon-tile ${r.accent === 'data' ? 'is-data' : ''}`}>
                  <Icon name={r.icon} />
                </span>
                <span>
                  <b>{r.short === r.name ? r.name : `${r.short}: ${r.name}`}</b>
                  <span>{r.blurb}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Base>

<style>
  .svc {
    padding-bottom: clamp(3rem, 6vw, 5rem);
    color: var(--color-white);
    background: var(--color-night);
  }
  .svc-row {
    display: grid;
    gap: 1.25rem;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
    border-top: 1px solid color-mix(in srgb, var(--color-white) 7%, transparent);
  }
  .svc-row:first-child {
    border-top: none;
  }
  @media (min-width: 1024px) {
    .svc-row {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 3rem;
    }
    .svc-label {
      position: sticky;
      top: 7rem;
      align-self: start;
    }
  }
  .svc-label {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .svc-label-ai {
    color: var(--color-violet-soft);
  }
  .svc-plain {
    max-width: 48rem;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.5;
    color: var(--color-white);
  }
  .svc-photo {
    margin: 2rem 0 0;
    height: clamp(14rem, 30vw, 24rem);
    overflow: hidden;
    border-radius: 1.6rem;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-white) 10%, transparent);
  }
  :global(.svc-img) {
    width: 100%;
    height: 115%;
    object-fit: cover;
  }
  .svc-pains {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 720px) {
    .svc-pains {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .svc-pains li {
    position: relative;
    padding: 1.15rem 1.25rem 1.15rem 3rem;
    font-size: 1.04rem;
    line-height: 1.5;
    color: var(--color-grey-200);
  }
  .svc-pains li::before {
    content: '';
    position: absolute;
    left: 1.25rem;
    top: 1.45rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 0.2rem;
    box-shadow: inset 0 0 0 1.5px var(--color-grey-400);
    transform: rotate(45deg);
  }
  .svc-steps {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  @media (min-width: 720px) {
    .svc-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1200px) {
    .svc-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .svc-steps li {
    padding: 1.3rem 1.35rem;
  }
  .svc-step-n {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
    font-weight: 800;
    font-variant-numeric: lining-nums;
    color: var(--color-iris-soft);
  }
  .svc-delivers {
    display: grid;
    gap: 0.75rem;
    max-width: 48rem;
    font-size: 1.06rem;
    line-height: 1.55;
    color: var(--color-grey-200);
  }
  .svc-facts {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  @media (min-width: 900px) {
    .svc-facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .svc-facts > div {
    padding: 1.15rem 1.25rem;
  }
  .svc-facts dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .svc-facts dt :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .svc-facts dd {
    margin-top: 0.45rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-white);
  }
  .svc-ai {
    padding: clamp(1.4rem, 3vw, 2rem);
    background: color-mix(in srgb, var(--color-violet) 8%, var(--color-night));
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--color-violet) 35%, transparent),
      0 30px 60px -40px color-mix(in srgb, var(--color-violet) 60%, transparent);
  }
  .svc-ai-list {
    margin-top: 1.1rem;
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--color-grey-200);
  }
  .svc-ai-list :global(li::before) {
    background: var(--color-violet-soft);
  }
  .svc-outcomes {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 720px) {
    .svc-outcomes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .svc-outcomes li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--color-white);
  }
  .svc-outcomes :global(svg) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    margin-top: 0.1rem;
    color: var(--color-iris-soft);
  }
  .svc-tech summary {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
  }
  .svc-tech summary::-webkit-details-marker {
    display: none;
  }
  .svc-tech summary :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    color: var(--color-iris-soft);
    transition: transform 0.4s var(--ease-expo);
  }
  .svc-tech[open] summary :global(svg) {
    transform: rotate(45deg);
  }
  .svc-tech ul {
    display: grid;
    gap: 0.65rem;
    padding: 0 1.25rem 1.3rem;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-grey-200);
  }
  .svc-tech li {
    padding-left: 1rem;
    border-left: 2px solid color-mix(in srgb, var(--color-azure) 60%, transparent);
  }
  .svc-related {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 900px) {
    .svc-related {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .svc-related li {
    display: flex;
  }
  .svc-rel {
    display: flex;
    width: 100%;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 1.15rem;
  }
  .svc-rel b {
    display: block;
    color: var(--color-white);
  }
  .svc-rel span span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.95rem;
    color: var(--color-grey-200);
  }
</style>
