---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import PostList from '../../components/blog/PostList.astro';
import Icon from '../../components/ui/Icon.astro';
import type { IconName } from '../../components/ui/icons';
import { formatDate, posts, readingTime, related, slugify, type Post } from '../../lib/blog';
import { SITE } from '../../data/site';

export const getStaticPaths = (async () => {
  const all = await posts();
  return all.map((post) => ({ params: { slug: post.id }, props: { post, all } }));
}) satisfies GetStaticPaths;

const { post, all } = Astro.props as { post: Post; all: Post[] };
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const d = post.data;
const url = `${SITE.url}/blog/${post.id}/`;
const crumbs = [
  { name: 'Blog', href: '/blog/' },
  { name: d.title, href: `/blog/${post.id}/` },
];
const schema = [
  {
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.date.toISOString(),
    dateModified: (d.updated ?? d.date).toISOString(),
    mainEntityOfPage: url,
    url,
    image: `${SITE.url}/og/blog/${post.id}.png`,
    articleSection: d.category,
    keywords: d.tags.join(', '),
    author: { '@type': 'Person', '@id': `${SITE.url}/about/#founder`, name: d.author, jobTitle: SITE.founder.role },
    publisher: { '@id': `${SITE.url}/#organization` },
  },
];
const more = related(post, all);
const ICON: Record<string, IconName> = { CMDB: 'cmdb', ITSM: 'itsm', ITOM: 'itom', ITAM: 'itam', AI: 'ai', Architecture: 'architecture', Integrations: 'integrations' };
---

<Base title={`${d.title} | Raleston Consulting`} description={d.description} crumbs={crumbs} schema={schema} type="article" noindex={d.draft}>
  <PageHero crumbs={crumbs} eyebrow={d.category} title={d.title} lead={d.description} icon={ICON[d.category] ?? 'book'}>
    <p class="art-meta">
      <span>By {d.author}, {SITE.founder.role}</span>
      <span><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></span>
      <span>{readingTime(post)} min read</span>
      {d.draft && <span class="art-draft">Draft for client review</span>}
    </p>
  </PageHero>
  <article class="section pt-4" data-theme="dark">
    <div class="gutter art-grid">
      <div>
        <div class="prose">
          <Content />
        </div>
        {
          d.tags.length > 0 && (
            <ul class="tags" aria-label="Tags">
              {d.tags.map((t) => (
                <li>
                  <a href={`/blog/tag/${slugify(t)}/`}>#{t}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <aside class="art-aside" aria-label="Article tools">
        {
          toc.length > 1 && (
            <nav class="toc" aria-labelledby="toc-title">
              <p id="toc-title" class="toc-h">On this page</p>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} data-toc={h.slug}>
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="card art-cta">
          <p class="art-cta-h">Want a second opinion on your platform?</p>
          <p class="art-cta-p">Talk to a certified architect about where you are and what to do next.</p>
          <a href="/contact/" class="link-arrow">Talk to an architect <Icon name="arrow" /></a>
        </div>
      </aside>
    </div>
  </article>
  {
    more.length > 0 && (
      <section class="section pt-0" data-theme="dark" aria-labelledby="more-title">
        <div class="gutter">
          <h2 id="more-title" class="h2 mb-8">Related reading</h2>
          <PostList items={more} />
        </div>
      </section>
    )
  }
</Base>

<script>
  // Highlight the section being read in the table of contents.
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
  if (links.size) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          for (const a of links.values()) a.removeAttribute('aria-current');
          links.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      { rootMargin: '-20% 0px -70% 0px' },
    );
    for (const id of links.keys()) {
      const h = document.getElementById(id);
      if (h) io.observe(h);
    }
  }
</script>

<style>
  .art-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 1100px) {
    .art-grid {
      grid-template-columns: minmax(0, 44rem) 17rem;
      justify-content: space-between;
    }
  }
  .art-aside {
    display: none;
  }
  @media (min-width: 1100px) {
    .art-aside {
      position: sticky;
      top: 7rem;
      display: grid;
      align-self: start;
      gap: 1.25rem;
    }
  }
  .toc-h,
  .art-cta-h {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-iris-soft);
  }
  .toc ol {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.8rem;
    border-left: 1px solid color-mix(in srgb, var(--color-white) 12%, transparent);
  }
  .toc a {
    display: block;
    margin-left: -1px;
    border-left: 2px solid transparent;
    padding: 0.4rem 0 0.4rem 0.9rem;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-grey-400);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .toc a:hover {
    color: var(--color-white);
  }
  .toc a[aria-current] {
    border-left-color: var(--color-iris-soft);
    color: var(--color-white);
  }
  .art-cta {
    padding: 1.25rem 1.3rem;
  }
  .art-cta-h {
    letter-spacing: 0.08em;
  }
  .art-cta-p {
    margin: 0.5rem 0 0.4rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-grey-200);
  }
  .prose :global(h2),
  .prose :global(h3) {
    scroll-margin-top: 7rem;
  }
  .art-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 1.75rem;
    font-size: 0.95rem;
    color: var(--color-grey-200);
  }
  .art-draft {
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
    font-weight: 700;
    color: var(--color-navy);
    background: var(--color-gold);
  }
  .prose {
    max-width: 44rem;
    font-size: 1.12rem;
    line-height: 1.75;
    color: var(--color-grey-200);
  }
  .prose :global(h2) {
    margin-top: 2.6rem;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-white);
  }
  .prose :global(h3) {
    margin-top: 2rem;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-white);
  }
  .prose :global(p) {
    margin-top: 1.1rem;
  }
  .prose :global(strong) {
    color: var(--color-white);
  }
  .prose :global(a) {
    color: var(--color-iris-soft);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .prose :global(ul),
  .prose :global(ol) {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding-left: 1.4rem;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li::marker) {
    color: var(--color-iris-soft);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: 44rem;
    margin-top: 2.5rem;
  }
  .tags a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    color: var(--color-grey-200);
    background: color-mix(in srgb, var(--color-white) 6%, transparent);
  }
  .tags a:hover {
    color: var(--color-white);
  }
</style>
