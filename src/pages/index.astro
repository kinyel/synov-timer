---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Foundation from '../components/sections/Foundation.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import AiSection from '../components/sections/AiSection.astro';
import Services from '../components/sections/Services.astro';
import CaseHighlights from '../components/sections/CaseHighlights.astro';
import Industries from '../components/sections/Industries.astro';
import Why from '../components/sections/Why.astro';
import TcpwaveBand from '../components/sections/TcpwaveBand.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import { HOME_FAQS } from '../data/faqs';
import { faqSchema } from '../lib/schema';
---

<Base
  title="Independent ServiceNow consultancy | Raleston Consulting"
  description="ServiceNow consultancy for clients worldwide. Certified architects for ITSM, ITOM, ITAM and the CMDB, with ServiceNow Otto, AI agents and MCP built in."
  schema={[faqSchema(HOME_FAQS)]}
  home
>
  <Hero />
  <AiSection />
  <Foundation />
  <Capabilities />
  <Services />
  <CaseHighlights />
  <Industries />
  <Why />
  <TcpwaveBand />
  <FaqSection />
</Base>
